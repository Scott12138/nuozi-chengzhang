{
  "meta": {
    "game": "挪字成章",
    "libVersion": "1.0.0",
    "updated": "2026-10-01",
    "totalWords": 103,
    "structureCode": {
      "lr": "左右结构（偏旁在左，部件在右）—— 如 枪 = 木 + 仓",
      "tb": "上下结构（偏旁在上，部件在下）—— 如 箭 = 竹 + 前",
      "ob": "半包围结构，本作暂不收录"
    },
    "authoringRule": "拆分依据《现代汉语词典》部首检字法 + 形声字「形旁+声旁」结构。所有条目必须人工校验，禁止用算法自动推导。新增字必须同时补全 pinyin / gloss / tag 三项，缺一不可。",
    "tagUsage": "tag 用于第三章「逛三园」结算念白与图鉴分组，取值见 tagGroups。",
    "fieldSemantics": {
      "radical": "牌面第一个部件，对应结构中靠左/靠上的那一半。注意：它【不一定】是形旁。例：鸽=合+鸟（形旁在右），radical 记「合」、part 记「鸟」。",
      "part": "牌面第二个部件，对应结构中靠右/靠下的那一半。",
      "structure": "lr=左右（radical 在左） / tb=上下（radical 在上）。仅用于拼字动画的合成方向，不参与配对判定。",
      "pairRule": "配对判定【不区分左右顺序、不区分形旁声旁】：只要两张牌能组成本章目标字库中的某一个字（或某一张彩蛋字），即判定合法。组合「木+仓」与「仓+木」等价，因为玩家连线的先后顺序是随机的。"
    }
  },
