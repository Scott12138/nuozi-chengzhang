/* ==LEVELS-V2-END== */

/* ============================================================
   3. 全局状态 & 存档
   ============================================================ */
let G = {
  board: [],        // 一维数组，每格 null 或 tile
  cols:6, rows:5, cell:56, gap:5,
  sel:null, drag:null, busy:false,
  stars:{},         // {关卡号: 星数}
  litWords:{},      // 已点亮字
  stats:{move:0, matched:0, hint:3, shuffle:1, bomb:1},
  t:0, timerId:null, deadline:0
};
let curLv = 1, curLevel = null, runWords = [], matchedWords = [], CFG = {cols:6,rows:5};
/* 下面两个必须声明在 boot() 之前：boot 会直接进关卡，否则触发 TDZ 报错 */
let RUN_PAIR = {};                 // 本关允许的配对表（由 buildRunPair 惰性构建）
/* 干扰字：看起来是偏旁，但和任何部件都配不成字。
   ★ 原第 8 个是「龴」—— 连 macOS 系统字体都没有这个字形，会渲染成空白牌，
     换成「丬」（爿的简化，见「壮状将」左边）：同样是偏旁长相、同样配不出字，零玩法损失。 */
const JUNK_CHARS = ['疒','匚','彳','卩','冫','屮','罒','丬','廾','弋'];

/* 简易存档（原型用 localStorage，真机用 wx.setStorageSync） */
function save(){ try{ localStorage.setItem('cz_nd_v3', JSON.stringify({stars:G.stars, lit:G.litWords})); }catch(e){} }
function load(){
  try{
    const s = JSON.parse(localStorage.getItem('cz_nd_v3')||'{}');
    if (s.stars) G.stars = s.stars;
    if (s.lit) G.litWords = s.lit;
  }catch(e){}
}

/* ============================================================
   4. 通用 UI
   ============================================================ */
function go(id){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  const el = document.getElementById(id);
  if (el) el.classList.add('active');
  if (id === 's-home') renderHome();
  if (id === 's-chap') renderChap();
  // 地图的节点连线依赖真实布局尺寸：必须等页面显示出来之后再画
  //（display:none 时 offsetTop/scrollHeight 全为 0，会画出一条 (0,0) 的线）
  if (id === 's-map') requestAnimationFrame(()=>requestAnimationFrame(()=>{
    drawMapPath(document.getElementById('map-wrap'));
  }));
}
function toast(msg, ms){
  const t = document.getElementById('toast');
  t.innerHTML = msg; t.classList.add('show');
  clearTimeout(t._h); t._h = setTimeout(()=>t.classList.remove('show'), ms||1550);
}
function showAd(reward, cb){
  const m = document.getElementById('mask');
  document.getElementById('dlg').innerHTML =
    '<h3>激励视频</h3><p>模拟广告位。真机接入 wx.createRewardedVideoAd。<br>看完可获得：<b style="color:var(--red)">'+reward+'</b></p>'+
    '<div class="dlg-btns"><button class="btn" onclick="closeMask();('+cb+')()">看完，领奖励</button>'+
    '<button class="btn ghost" onclick="closeMask()">放弃</button></div>';
  m.classList.add('show');
}
function closeMask(){ document.getElementById('mask').classList.remove('show'); }
function toggleSw(id){ document.getElementById(id).classList.toggle('on'); }
function fmt(s){ s=Math.max(0,Math.ceil(s)); return String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0'); }

function renderHome(){
  let st=0; for(const k in G.stars) st += G.stars[k];
  document.getElementById('h-stat-star').textContent = st;
  document.getElementById('h-stat-word').textContent = Object.keys(G.litWords).length;
  document.getElementById('h-stat-lv').textContent = Object.keys(G.stars).length;
}
function renderChap(){
  const box = document.getElementById('chap-list'); box.innerHTML = '';
  CHAPTERS.forEach(c=>{
    const lvs = LEVELS.filter(l=>l.ch===c.id);
    const prev = LEVELS.filter(l=>l.ch === c.id - 1).pop();
    const unlocked = c.id === 1 || (prev && G.stars[prev.n] !== undefined);
    const done = lvs.filter(l=>G.stars[l.n]).length;
    const st = lvs.reduce((s,l)=>s+(G.stars[l.n]||0),0);
    // 预览取本章字库（不是各关的 words[0]——那样每关取到的都是同一个字，会显示成「枪 枪 枪 枪 枪」）
    const preview = (CH_POOL[c.id] || []).slice(0, 6).join(' ');
    const el = document.createElement('div');
    el.className = 'chap' + (unlocked?'':' locked');
    el.innerHTML =
      '<h3>'+c.name+'</h3><div class="muted">'+c.sub+'</div>'+
      '<div class="preview">'+preview+'</div>'+
      '<div class="meta"><span class="stars">'+
        starStr(Math.round(st/Math.max(1,lvs.length*3)*3))+' <span class="cnt" style="color:var(--ink3)">'+done+'/'+lvs.length+'</span>'+
      '</span><span class="cnt">'+(unlocked?'可挑战':'通关上一章解锁')+'</span></div>';
    if (unlocked) el.onclick = ()=>{ renderMap(c.id); go('s-map'); };
    box.appendChild(el);
  });
}
function starStr(n){ let s=''; for(let i=0;i<3;i++) s += i<n ? '★' : '<span class="off">★</span>'; return s; }

function renderMap(ch){
  ch = ch || 1;
  const c = CHAPTERS.find(x=>x.id===ch);
  document.getElementById('map-title').textContent = c.name;
  const lvs = LEVELS.filter(l=>l.ch===ch);
  const done = lvs.filter(l=>G.stars[l.n]).length;
  document.getElementById('map-info').innerHTML = '共 ' + lvs.length + ' 关 · 已通关 ' + done + ' 关';
  const wrap = document.getElementById('map-wrap'); wrap.innerHTML = '';
  const firstUndone = lvs.findIndex(x=>!G.stars[x.n]);
  lvs.forEach((l,i)=>{
    const unlocked = i === 0 || G.stars[lvs[i-1].n] !== undefined || ch === 1;
    const row = document.createElement('div');
    row.className = 'node-row';
    row.style.justifyContent = i%3===0 ? 'flex-start' : (i%3===1 ? 'center' : 'flex-end');
    const st = G.stars[l.n];
    const nd = document.createElement('div');
    nd.className = 'node' + (st?' done':'') + (!unlocked?' locked':'') + (unlocked && !st && i===firstUndone ? ' cur':'');
    nd.innerHTML = '<div class="n-st">'+(st?starStr(st):'')+'</div><div class="n-id">'+(l.n)+'</div>';
    if (unlocked) nd.onclick = ()=> startLevel(l.n);
    else nd.onclick = ()=> toast('先通过前面的关卡');
    row.appendChild(nd);
    wrap.appendChild(row);
  });
}
/* 关卡节点之间的虚线路径：把散落的圆点连成一条“关卡小径” */
function drawMapPath(wrap){
  const old = wrap.querySelector('.map-path'); if (old) old.remove();
  const rows = [...wrap.querySelectorAll('.node-row')];
  const pts = [];
  rows.forEach(row=>{
    [...row.querySelectorAll('.node')].forEach(nd=>{
      pts.push({ x: nd.offsetLeft + nd.offsetWidth/2,
                 y: row.offsetTop + nd.offsetTop + nd.offsetHeight/2 });
    });
  });
  if (pts.length < 2) return;
  const NS = 'http://www.w3.org/2000/svg';
  const svg = document.createElementNS(NS, 'svg');
  svg.setAttribute('class', 'map-path');
  svg.setAttribute('width', '100%');
  svg.setAttribute('height', wrap.scrollHeight + 'px');
  svg.style.cssText = 'position:absolute;left:0;top:0;pointer-events:none;z-index:0;';
  let d = 'M' + pts[0].x + ',' + pts[0].y;
  for (let i = 1; i < pts.length; i++){
    const a = pts[i-1], b = pts[i], my = (a.y + b.y) / 2;
    d += ' C' + a.x + ',' + my + ' ' + b.x + ',' + my + ' ' + b.x + ',' + b.y;
  }
  const p = document.createElementNS(NS, 'path');
  p.setAttribute('d', d);
  p.setAttribute('fill', 'none');
  p.setAttribute('stroke', 'rgba(181,53,42,.26)');
  p.setAttribute('stroke-width', '2');
  p.setAttribute('stroke-dasharray', '5 8');
  p.setAttribute('stroke-linecap', 'round');
  svg.appendChild(p);
  wrap.appendChild(svg);
}
function renderAtlas(){
  const wrap = document.getElementById('atlas-wrap'); wrap.innerHTML = '';
  const lit = Object.keys(G.litWords).length, tot = Object.keys(WORDS).length;
  document.getElementById('atlas-cnt').textContent = lit + ' / ' + tot;
  const byCh = {};
  LEVELS.forEach(l=>{ (byCh[l.ch] = byCh[l.ch]||new Set()); l.words.forEach(w=>byCh[l.ch].add(w)); });
  Object.keys(byCh).forEach(ch=>{
    const c = CHAPTERS.find(x=>x.id===+ch);
    const h = document.createElement('div'); h.className='atlas-sec'; h.textContent = c.name; wrap.appendChild(h);
    const grid = document.createElement('div'); grid.className='atlas-grid';
    [...byCh[ch]].forEach(w=>{
      const on = !!G.litWords[w];
      const d = document.createElement('div');
      d.className = 'aw' + (on?' lit':'');
      d.innerHTML = on
        ? '<div class="w">'+w+'</div><div class="py">'+WORDS[w].a+' + '+WORDS[w].b+'</div>'
        : '<div class="lock">？</div>';
      grid.appendChild(d);
    });
    wrap.appendChild(grid);
  });
}

/* ============================================================
   5. 启动
   ============================================================ */
(function boot(){
  load();
  const q = new URLSearchParams(location.search);
  const s = q.get('s');                      // 评审直达参数 ?s=xxx
  if (s){
    const lv = +(q.get('lv') || 1);
    if (s === 'home') go('s-home');
    else if (s === 'chap') go('s-chap');
    else if (s === 'map'){ renderMap(+(q.get('ch') || 1)); go('s-map'); }
    else if (s === 'atlas'){ renderAtlas(); go('s-atlas'); }
    else if (s === 'set') go('s-set');
    else if (s === 'play'){
      startLevel(lv);
      if (q.get('auto')) setTimeout(()=>afterBoardReady(autoPlay), 300);
      if (q.get('drag')) setTimeout(()=>afterBoardReady(demoDrag), 400);   // 截「拖动中」用
    }
    else if (s === 'clear'){
      startLevel(lv);
      setTimeout(()=>{ G.stats.move = 18; G.stats.matched = 9; matchedWords = ['枪','棍','棒'];
        runWords.forEach(x=>x.got = x.need); finishClear(); }, 260);
    }
    else go('s-home');
    return;
  }
  let p = 0;
  const bar = document.getElementById('boot-bar');
  const t = setInterval(()=>{
    p += 11 + Math.random()*15;
    if (p >= 100){ p = 100; clearInterval(t); setTimeout(()=>go('s-home'), 300); }
    bar.style.width = p + '%';
  }, 120);
})();

/* ============================================================
   6. 玩法内核 · 挪对机制
   判定：两张可配对牌，位于同一行或同一列且中间无阻挡 → 可消除
   操作：① 点击（已对齐的直接消）
        ② 拖动（挪牌创造对齐）
   ★ 拖动约束（v2.2）：一张牌只能沿「它所在的那一行、或那一列」滑动，
     且不能跨越别的牌 —— 遇牌即停。范围由 slideRange() 统一计算，
     拖动 / 提示 / 死局检测 / 自动演示四处共用，规则不会打架。
   ============================================================ */
function shuffle(a){ for(let i=a.length-1;i>0;i--){const j=(Math.random()*(i+1))|0;const t=a[i];a[i]=a[j];a[j]=t;} return a; }
function allTiles(){ const r=[]; for(const t of G.board) if(t) r.push(t); return r; }
function tileAt(r,c){ return (r<0||r>=G.rows||c<0||c>=G.cols) ? null : (G.board[r*G.cols+c]||null); }
function inB(r,c){ return r>=0 && r<G.rows && c>=0 && c<G.cols; }
function idxOf(t){ return t.r*G.cols + t.c; }

/* ---------- 6.1 配对判定 ---------- */
function buildRunPair(lv){
  RUN_PAIR = {};
  lv.words.forEach(w=>{ const {a,b} = WORDS[w]; RUN_PAIR[a+'|'+b] = w; RUN_PAIR[b+'|'+a] = w; });
}
function canPair(a,b){
  if (!a || !b || a === b) return false;
  if (a.kind === 'junk' || b.kind === 'junk') return false;
  if (a.kind === b.kind) return false;            // 必须一偏旁 + 一部件
  return !!RUN_PAIR[a.char + '|' + b.char];
}
function pairWord(a,b){ return RUN_PAIR[a.char + '|' + b.char] || ''; }

/* 同一行/列，中间无牌阻挡 */
function lineClear(a,b){
  if (a.r === b.r){
    const l = Math.min(a.c,b.c), h = Math.max(a.c,b.c);
    for (let c = l+1; c < h; c++) if (tileAt(a.r,c)) return false;
    return true;
  }
  if (a.c === b.c){
    const l = Math.min(a.r,b.r), h = Math.max(a.r,b.r);
    for (let r = l+1; r < h; r++) if (tileAt(r,a.c)) return false;
    return true;
  }
  return false;
}
/* 返回与 t 当前可立即消除的所有牌 */
function matchTargets(t){
  const out = [];
  for (const o of allTiles()){
    if (o === t) continue;
    if (!canPair(t,o)) continue;
    if (lineClear(t,o)) out.push(o);
  }
  return out;
}

/* ---------- 6.1b 滑动范围（「挪对」的核心约束） ---------- */
/* 一张牌只能沿「它自己所在的那一行、或那一列」滑动，且不能跨越别的牌——
   朝一个方向扫过去，碰到牌就停，更远的格子都够不着。
   ★ 这里是唯一真源：拖动限制、提示、死局检测、自动演示四处全部调用它，
     避免「提示给出的走法玩家却拖不过去」这类规则打架。 */
function slideRange(t){
  let up = t.r, down = t.r, left = t.c, right = t.c;
  while (inB(up-1, t.c)    && !tileAt(up-1, t.c))    up--;
  while (inB(down+1, t.c)  && !tileAt(down+1, t.c))  down++;
  while (inB(t.r, left-1)  && !tileAt(t.r, left-1))  left--;
  while (inB(t.r, right+1) && !tileAt(t.r, right+1)) right++;
  return {up:up, down:down, left:left, right:right};
}
/* 这张牌此刻还有没有滑动余地（上下左右全被堵死 → false） */
function canSlide(t){
  const g = slideRange(t);
  return g.up !== t.r || g.down !== t.r || g.left !== t.c || g.right !== t.c;
}
/* 该牌当前能滑到的所有空格（必然与它同行或同列） */
function reachableCells(t){
  const g = slideRange(t), out = [];
  for (let c = g.left; c <= g.right; c++) if (c !== t.c) out.push({r:t.r, c:c});
  for (let r = g.up;   r <= g.down;  r++) if (r !== t.r) out.push({r:r, c:t.c});
  return out;
}
/* 把「能挪到哪」画在盘面上 */
function markReachable(range, t){
  const bgs = document.getElementById('board').querySelectorAll('.cellbg');
  for (const e of bgs) e.classList.remove('reach');
  if (!range || !t) return;
  for (let c = range.left; c <= range.right; c++){
    if (c === t.c) continue;
    const e = bgs[t.r*G.cols + c]; if (e) e.classList.add('reach');
  }
  for (let r = range.up; r <= range.down; r++){
    if (r === t.r) continue;
    const e = bgs[r*G.cols + t.c]; if (e) e.classList.add('reach');
  }
}
/* 给定拖动位移，返回它被约束后的落点。
   axis：'h' 横滑 / 'v' 竖滑（谁拖得多听谁的）。 */
function clampSlide(d, nx, ny){
  const g = d.range;
  if (d.axis === 'v'){
    let r = Math.round((ny - G.gap/2) / G.cell);
    r = Math.max(g.up, Math.min(g.down, r));      // 被牌挡住 → 停在它前面
    return {r:r, c:d.homeC};
  }
  let c = Math.round((nx - G.gap/2) / G.cell);
  c = Math.max(g.left, Math.min(g.right, c));
  return {r:d.homeR, c:c};
}

/* ---------- 6.2 关卡生成 ---------- */
function computeNeed(lv){
  const ks = lv.words.map(w=>({w, a:WORDS[w].a, b:WORDS[w].b}));
  const need = {};
  for (let i=0;i<lv.pairs;i++){ const k = ks[i % ks.length]; need[k.w] = (need[k.w]||0) + 1; }
  return need;
}
function buildDeck(lv){
  const ks = lv.words.map(w=>({a:WORDS[w].a, b:WORDS[w].b}));
  const deck = [];
  for (let i=0;i<lv.pairs;i++){
    const k = ks[i % ks.length];
    deck.push({char:k.a, kind:'radical'});
    deck.push({char:k.b, kind:'part'});
  }
  for (let i=0;i<lv.junk;i++) deck.push({char:JUNK_CHARS[i % JUNK_CHARS.length], kind:'junk'});
  return shuffle(deck);
}
function generateLevel(lv){
  const cols = lv.cols, rows = lv.rows, total = cols*rows;
  const deck = buildDeck(lv);
  const board = new Array(total).fill(null);
  const slots = shuffle([...Array(total).keys()]).slice(0, deck.length);
  deck.forEach((d,i)=>{
    const idx = slots[i];
    d.id = i; d.r = Math.floor(idx/cols); d.c = idx % cols;
    board[idx] = d;
  });
  return board;
}
/* 棋盘上是否已有「直接可消」的一对（用于教学关保证正反馈） */
function hasDirectMatch(){
  const ts = allTiles();
  for (let i=0;i<ts.length;i++) for (let j=i+1;j<ts.length;j++)
    if (canPair(ts[i],ts[j]) && lineClear(ts[i],ts[j])) return true;
  return false;
}

/* ---------- 6.3 尺寸 & 渲染 ---------- */
function computeCell(lv){
  const wrap = document.querySelector('.board-wrap');
  let availW = 352, availH = 420;
  if (wrap && wrap.clientWidth){
    let pl = 10, pr = 10, pt = 2, pb = 2;
    try {
      const cs = getComputedStyle(wrap);
      pl = parseFloat(cs.paddingLeft) || 0; pr = parseFloat(cs.paddingRight) || 0;
      pt = parseFloat(cs.paddingTop) || 0;  pb = parseFloat(cs.paddingBottom) || 0;
    } catch(e){}
    availW = wrap.clientWidth  - pl - pr;     // clientWidth 含 padding，必须减掉
    availH = wrap.clientHeight - pt - pb;
  }
  const cell = Math.min(Math.floor((availW - 4) / lv.cols), Math.floor((availH - 4) / lv.rows));
  return Math.max(32, Math.min(cell, 62));
}
function buildCellBg(){
  const boardEl = document.getElementById('board');
  [...boardEl.querySelectorAll('.cellbg')].forEach(e=>e.remove());
  for (let r=0;r<G.rows;r++) for (let c=0;c<G.cols;c++){
    const d = document.createElement('div');
    d.className = 'cellbg';
    d.style.left = (c*G.cell + G.gap/2) + 'px';
    d.style.top  = (r*G.cell + G.gap/2) + 'px';
    d.style.width  = (G.cell - G.gap) + 'px';
    d.style.height = (G.cell - G.gap) + 'px';
    boardEl.appendChild(d);
  }
}
/* 位置统一走 transform:translate。绝不要用 left/top ——
   那会每帧重排+重绘，水墨牌面的 filter 跟着重算（实测 60fps → 39fps）。 */
function tileXY(el, x, y, extra){
  el.style.transform = 'translate(' + x + 'px,' + y + 'px)' + (extra ? ' ' + extra : '');
}
/* 一张牌的画：宣纸 + 毛笔字 + 右下朱印（朱印是「惜色如金」的那个红点）。
   干扰牌把字缩到 62% 并用淡墨，配合 CSS 的压暗与朱砂斜划。 */
function tileArt(t){
  const opt = { style:'bai', wash:true, seal:true };
  if (t.kind === 'junk') opt.fit = 0.62;
  return InkTile.svg(t.char, opt);
}
function makeTileEl(t){
  const el = document.createElement('div');
  el.className = 'tile ' + t.kind;
  const s = (G.cell - G.gap);
  el.style.width  = s + 'px';
  el.style.height = s + 'px';
  el.innerHTML = '<svg viewBox="0 0 1000 1000">' + tileArt(t) + '</svg>';
  tileXY(el, t.c*G.cell + G.gap/2, t.r*G.cell + G.gap/2);
  el._tile = t; t.el = el;
  el.addEventListener('pointerdown', onDown);
  return el;
}
function renderBoard(){
  const boardEl = document.getElementById('board');
  [...boardEl.querySelectorAll('.tile,.melt')].forEach(e=>e.remove());
  boardEl.style.width  = (G.cols*G.cell) + 'px';
  boardEl.style.height = (G.rows*G.cell) + 'px';
  buildCellBg();
  allTiles().forEach(t=> boardEl.appendChild(makeTileEl(t)));
}
function placeEl(t, animate){
  if (!t.el) return;
  if (animate === false) t.el.style.transition = 'none';
  tileXY(t.el, t.c*G.cell + G.gap/2, t.r*G.cell + G.gap/2);
  if (animate === false) requestAnimationFrame(()=>{ if (t.el) t.el.style.transition = ''; });
}
function svg(){ return document.getElementById('svg-layer'); }
function clearSvg(){ const s = svg(); while (s.firstChild) s.removeChild(s.firstChild); }
function drawLink(a,b,color){
  const s = svg();
  const x1 = a.c*G.cell + G.cell/2, y1 = a.r*G.cell + G.cell/2;
  const x2 = b.c*G.cell + G.cell/2, y2 = b.r*G.cell + G.cell/2;
  const ln = document.createElementNS('http://www.w3.org/2000/svg','line');
  ln.setAttribute('x1',x1); ln.setAttribute('y1',y1);
  ln.setAttribute('x2',x2); ln.setAttribute('y2',y2);
  ln.setAttribute('stroke', color || 'rgba(200,160,46,.95)');
  ln.setAttribute('stroke-width','4');
  ln.setAttribute('stroke-linecap','round');
  ln.setAttribute('stroke-dasharray','7 6');
  s.appendChild(ln);
  return ln;
}
function clearHl(){ document.querySelectorAll('.tile.hl,.tile.hint').forEach(e=>e.classList.remove('hl','hint')); }

/* ---------- 6.4 目标条 ---------- */
function renderGoals(){
  const box = document.getElementById('goal-bar');
  box.innerHTML = runWords.map(x=>
    '<div class="goal-chip' + (x.got >= x.need ? ' done' : '') + '">' +
      '<span class="g-word">' + x.w + '</span>' +
      '<span class="g-num">' + x.got + '/' + x.need + '</span>' +
    '</div>'
  ).join('');
}
/* 已成字条：只展示已经合成出来的字，避免剧透未合成字的拆法 */
function renderMade(){
  const box = document.getElementById('made-strip');
  if (!box) return;
  const got = runWords.filter(x=>x.got > 0);
  if (!got.length){
    box.innerHTML = '<div class="ms-empty">字牌只能沿<b>本行或本列</b>滑动，遇到牌即停<br>把偏旁与部件挪到同一行或同一列（中间无挡）即可合成</div>';
    return;
  }
  box.innerHTML = got.map(x=>{
    const w = WORDS[x.w];
    return '<div class="ms-card">' +
      '<span class="ms-p r">' + w.a + '</span><span class="ms-op">＋</span>' +
      '<span class="ms-p p">' + w.b + '</span><span class="ms-op">＝</span>' +
      '<span class="ms-p w">' + x.w + '</span></div>';
  }).join('');
}
function renderTools(){
  document.getElementById('n-hint').textContent = G.stats.hint;
  document.getElementById('n-shuffle').textContent = G.stats.shuffle;
  document.getElementById('n-bomb').textContent = G.stats.bomb;
  document.getElementById('t-hint').disabled = G.stats.hint <= 0;
  document.getElementById('t-shuffle').disabled = G.stats.shuffle <= 0;
  document.getElementById('t-bomb').disabled = G.stats.bomb <= 0;
}

/* ---------- 6.5 开始一关 ---------- */
function startLevel(n){
  const lv = LEVELS.find(l=>l.n === n) || LEVELS[0];
  curLv = lv.n; curLevel = lv;
  G.cols = lv.cols; G.rows = lv.rows;
  buildRunPair(lv);
  G.cell = computeCell(lv); G.gap = Math.max(3, Math.round(G.cell*0.09));
  // 生成盘面（教学关保证至少有一对可直接消，给正反馈）
  let bd = null;
  for (let k=0;k<25;k++){
    bd = generateLevel(lv);
    G.board = bd;
    if (hasDirectMatch()) break;
  }
  G.board = bd;
  G.busy = false; G.sel = null; G.drag = null;
  G.stats = {move:0, matched:0, hint:3, shuffle:1, bomb:1};
  matchedWords = [];
  const need = computeNeed(lv);
  runWords = Object.keys(need).map(w=>({w:w, need:need[w], got:0}));

  document.getElementById('play-title').textContent = '第 ' + lv.n + ' 关 · ' + CHAPTERS.find(c=>c.id===lv.ch).name.replace(/^第.章 · /,'');
  const tipsEl = document.getElementById('tips');
  if (lv.tip){ tipsEl.textContent = '拆法提示：' + lv.tip; tipsEl.classList.add('show'); }
  else tipsEl.classList.remove('show');

  go('s-play');
  // 等两帧后再量尺寸（首帧 clientHeight 可能为 0）
  requestAnimationFrame(()=> requestAnimationFrame(()=>{
    G.cell = computeCell(lv); G.gap = Math.max(3, Math.round(G.cell*0.09));
    renderBoard(); renderGoals(); renderMade(); renderTools();
  }));
  G.t = lv.time; G.deadline = Date.now() + lv.time*1000;
  document.getElementById('timer').textContent = fmt(G.t);
  document.getElementById('timer').classList.remove('warn');
  startTimer();
}
function startTimer(){
  stopTimer();
  document.getElementById('timer').textContent = fmt(G.t);
  G.timerId = setInterval(()=>{
    G.t = (G.deadline - Date.now())/1000;
    const el = document.getElementById('timer');
    el.textContent = fmt(G.t);
    if (G.t <= 15) el.classList.add('warn');
    if (G.t <= 0) { stopTimer(); finishFail(); }
  }, 200);
}
function stopTimer(){ if (G.timerId){ clearInterval(G.timerId); G.timerId = null; } }
function exitLevel(){ stopTimer(); go('s-map'); renderMap(curLevel ? curLevel.ch : 1); }

/* ---------- 6.6 交互：拖动 + 点击 ---------- */
function onDown(e){
  if (G.busy) return;
  const el = e.currentTarget, t = el._tile;
  if (!t) return;
  if (e.pointerType === 'mouse' && e.button !== 0) return;   // 鼠标只响应左键
  e.preventDefault();
  try { el.setPointerCapture(e.pointerId); } catch(err){}
  const br = document.getElementById('board').getBoundingClientRect();
  // ★ 拿起的一瞬间就把「这张牌能滑到哪」算死：范围只由它所在的这一行/列决定
  const range = slideRange(t);
  G.drag = {
    t:t, el:el, pointerId:e.pointerId,
    homeR:t.r, homeC:t.c, range:range,
    startX:e.clientX, startY:e.clientY,
    offX: e.clientX - br.left - (t.c*G.cell + G.gap/2),
    offY: e.clientY - br.top  - (t.r*G.cell + G.gap/2),
    moved:false, axis:null, hover:null, last:null
  };
  el.classList.add('dragging');
  markReachable(range, t);          // 点亮本行/本列能滑到的空格
  // ★ 必须挂到 document：指针捕获后事件仍会冒泡到这里；
  //   若捕获失败（部分浏览器/环境），事件也会从落点元素冒泡上来，两条路径都覆盖。
  document.addEventListener('pointermove', onMove);
  document.addEventListener('pointerup', onUp);
  document.addEventListener('pointercancel', onUp);
}
function onMove(e){
  const d = G.drag; if (!d) return;
  const dx = e.clientX - d.startX, dy = e.clientY - d.startY;
  if (!d.moved && Math.hypot(dx,dy) > 6) d.moved = true;
  if (!d.moved) return;
  // ★ 约束一：先定一条轴 —— 横向拖得多就横滑，纵向拖得多就竖滑。
  //   锁定后整段拖动都只在这条轴上行进，牌不会斜着飞到别的行/列去。
  if (!d.axis) d.axis = Math.abs(dx) >= Math.abs(dy) ? 'h' : 'v';
  const br = document.getElementById('board').getBoundingClientRect();
  const nx = e.clientX - br.left - d.offX;
  const ny = e.clientY - br.top  - d.offY;
  // ★ 约束二：落点被夹进滑动范围 —— 等价于「不能跨过挡路的牌」
  const p = clampSlide(d, nx, ny);
  d.el.style.transition = 'none';
  const tilt = d.axis === 'h' ? Math.max(-6, Math.min(6, dx*0.05)) : 0;
  tileXY(d.el, p.c*G.cell + G.gap/2, p.r*G.cell + G.gap/2,
         'scale(1.1) rotate(' + tilt + 'deg)');
  d.last = p;
  // —— 实时预判：这个落点能不能凑成一对？——
  clearHl(); clearSvg();
  d.hover = null;
  if (p.r === d.homeR && p.c === d.homeC) return;    // 还在原位，没什么可预览的
  const oI = d.homeR*G.cols + d.homeC, nI = p.r*G.cols + p.c;
  G.board[oI] = null; G.board[nI] = d.t; d.t.r = p.r; d.t.c = p.c;         // 模拟落位
  const hits = matchTargets(d.t);
  G.board[nI] = null; G.board[oI] = d.t; d.t.r = d.homeR; d.t.c = d.homeC; // 还原
  if (hits.length){
    d.hover = {r:p.r, c:p.c, hits:hits};
    hits.forEach(o=>o.el && o.el.classList.add('hl'));
    drawLink({r:p.r, c:p.c}, hits[0], 'rgba(200,160,46,.9)');
  }
}
function onUp(e){
  document.removeEventListener('pointermove', onMove);
  document.removeEventListener('pointerup', onUp);
  document.removeEventListener('pointercancel', onUp);
  const d = G.drag; if (!d) return;
  G.drag = null;
  d.el.classList.remove('dragging');
  /* ★ 只摘掉拖动时的放大/倾斜，保留当前位置的 translate ——
     若直接写 transform=''，会把 translate 也一起清掉，牌会跳回棋盘左上角。 */
  const lp = d.last || {r:d.homeR, c:d.homeC};
  tileXY(d.el, lp.c*G.cell + G.gap/2, lp.r*G.cell + G.gap/2);
  d.el.style.transition = '';   // 清掉拖动期间写入的 transition:none，否则回弹/落位是硬跳
  try { d.el.releasePointerCapture(e.pointerId); } catch(err){}
  clearHl(); clearSvg(); markReachable(null);
  if (!d.moved){
    placeEl(d.t, true);
    doClick(d.t);
    return;
  }
  const p = d.last || {r:d.homeR, c:d.homeC};
  if (p.r === d.homeR && p.c === d.homeC){
    placeEl(d.t, true);                                  // 落回原位
    if (!canSlide(d.t)){                                 // 整张牌被堵死 → 明确告诉玩家，别让人以为是 bug
      shakeTile(d.t);
      toast('这张牌上下左右都被挡住了<br>先把它旁边的牌挪开');
    }
    return;
  }
  moveTile(d.t, p.r, p.c, true);                         // 落点必然与起点同行或同列
}
function moveTile(t, r, c, thenCheck){
  G.board[idxOf(t)] = null;
  t.r = r; t.c = c;
  G.board[r*G.cols+c] = t;
  G.stats.move++;
  placeEl(t, true);
  if (thenCheck){
    setTimeout(()=>{
      const hits = matchTargets(t);
      if (hits.length) resolveMatch(t, hits[0]);
      else checkDeadlock();
    }, 130);
  }
}
function doClick(t){
  if (G.busy) return;
  const hits = matchTargets(t);
  if (hits.length){ resolveMatch(t, hits[0]); return; }
  const cands = allTiles().filter(o=>canPair(t,o));
  if (cands.length){
    toast('它和「' + cands[0].char + '」能拼成字<br>但不在同一行、也不在同一列 —— 拖一张过去让它们对齐');
    cands.forEach(o=>{ if (o.el){ o.el.classList.add('hint'); setTimeout(()=>o.el&&o.el.classList.remove('hint'), 1300); } });
  } else {
    shakeTile(t);
    if (t.kind === 'junk') toast('这是干扰牌，拼不成字');
  }
}
function shakeTile(t){
  if (!t.el) return;
  t.el.classList.add('shake');
  setTimeout(()=>t.el && t.el.classList.remove('shake'), 340);
}

/* ---------- 6.7 消除 ---------- */
/* 一次操作只消一对（不做自动连锁）：玩家每消一对都要自己出手，
   否则一次点击会把场上所有已对齐的牌一起清掉，游戏变成“自己玩自己”。 */
function resolveMatch(a, b){
  const word = pairWord(a,b);
  if (!word) return;
  G.busy = true;
  // 1) 从棋盘移除
  G.board[idxOf(a)] = null;
  G.board[idxOf(b)] = null;
  G.stats.matched++;
  const rw = runWords.find(x=>x.w === word);
  if (rw) rw.got++;
  if (!matchedWords.includes(word)) matchedWords.push(word);
  // 2) 画连线
  const ln = drawLink(a, b, 'rgba(200,160,46,.98)');
  // 3) 双牌飞向中点 + 消失
  const mxc = (a.c + b.c)/2, myc = (a.r + b.r)/2;
  [a,b].forEach(t=>{
    if (!t.el) return;
    t.el.style.transition = 'transform .18s ease, opacity .18s ease';
    tileXY(t.el, mxc*G.cell + G.gap/2, myc*G.cell + G.gap/2, 'scale(.55)');
    t.el.style.opacity = '0';
  });
  // 4) 合成字浮现
  const melt = document.createElement('div');
  melt.className = 'melt';
  const bs = (G.cell - G.gap);
  const mx = mxc*G.cell + G.gap/2, my = myc*G.cell + G.gap/2;
  melt.style.width  = bs + 'px';
  melt.style.height = bs + 'px';
  melt.innerHTML = '<svg viewBox="0 0 1000 1000">' +
    InkTile.svg(word, { style:'bai', wash:true, seal:false, fit:0.9 }) + '</svg>';
  tileXY(melt, mx, my, 'scale(.5)');
  melt.style.opacity = '0';
  melt.style.transition = 'transform .34s cubic-bezier(.2,1.5,.4,1), opacity .2s';
  document.getElementById('board').appendChild(melt);
  requestAnimationFrame(()=>{
    tileXY(melt, mx, my, 'scale(1.42)');
    melt.style.opacity = '1';
  });
  setTimeout(()=>{ melt.style.opacity = '0'; tileXY(melt, mx, my, 'scale(1.9)'); }, 360);
  setTimeout(()=>{ melt.remove(); if (ln && ln.parentNode) ln.parentNode.removeChild(ln); }, 700);
  // 5) 清理 DOM → 判定胜负 → 解锁操作
  setTimeout(()=>{
    if (a.el) a.el.remove();
    if (b.el) b.el.remove();
    renderGoals();
    renderMade();
    clearSvg();
    const more = allTiles().filter(t=>t.kind!=='junk');
    if (more.length === 0){ G.busy = false; finishClear(); return; }
    G.busy = false;
    checkDeadlock();
  }, 480);
}

/* ---------- 6.8 死局检测 / 提示 / 道具 ---------- */
/* 找一步「玩家真的做得到」的挪法。
   ★ 候选落点必须来自 reachableCells —— 即「沿本行/本列、且中间不被挡」。
     否则提示会给出一个拖动限制下根本走不到的格子，等于骗玩家；
     死局检测也会跟着误判（明明走不通却说还有解）。 */
function findSuggest(){
  const ts = shuffle(allTiles().slice());
  for (const t of ts){
    const cells = shuffle(reachableCells(t));
    for (const x of cells){
      const oR = t.r, oC = t.c, oI = idxOf(t), nI = x.r*G.cols + x.c;
      G.board[oI] = null; G.board[nI] = t; t.r = x.r; t.c = x.c;
      const hits = matchTargets(t);
      G.board[nI] = null; G.board[oI] = t; t.r = oR; t.c = oC;
      if (hits.length) return {tile:t, r:x.r, c:x.c, hit:hits[0]};
    }
  }
  return null;
}
function checkDeadlock(){
  if (G.busy) return;
  if (hasDirectMatch()) return;          // 场上还有「点一下就能消」的，不算死局
  const s = findSuggest();
  if (!s){
    if (G.stats.shuffle > 0){
      const el = document.getElementById('t-shuffle');
      if (el) el.classList.add('glow');
      toast('已无可立即凑成的挪法<br>用「洗牌」重置盘面', 2200);
    } else {
      // ★ 加了滑动约束之后，死局是真会出现的，而洗牌次数可能已经用尽。
      //   绝不能把玩家丢在一个「既点不动、又滑不动」的盘面上 —— 免费洗一次兜底。
      toast('已无可立即凑成的挪法<br>自动为你重排盘面', 2400);
      setTimeout(()=>useShuffle(true), 800);
    }
  }
}
function useHint(){
  if (G.stats.hint <= 0 || G.busy) return;
  // 优先提示「已经对齐、点一下就能消」的那一对
  const ts = allTiles();
  for (let i=0;i<ts.length;i++) for (let j=i+1;j<ts.length;j++){
    if (canPair(ts[i],ts[j]) && lineClear(ts[i],ts[j])){
      G.stats.hint--; renderTools();
      const a = ts[i], b = ts[j];
      if (a.el) a.el.classList.add('hint');
      if (b.el) b.el.classList.add('hint');
      drawLink(a, b, 'rgba(46,122,112,.95)');
      setTimeout(()=>{ if(a.el)a.el.classList.remove('hint'); if(b.el)b.el.classList.remove('hint'); clearSvg(); }, 1900);
      toast('「' + a.char + '」和「' + b.char + '」已经对齐了<br>点一下就能拼成「' + pairWord(a,b) + '」', 2400);
      return;
    }
  }
  const s = findSuggest();
  if (!s){ toast('这局已经无可凑成的挪法了，试试洗牌'); return; }
  G.stats.hint--;
  renderTools();
  if (s.tile.el) s.tile.el.classList.add('hint');
  setTimeout(()=>{ if (s.tile.el) s.tile.el.classList.remove('hint'); }, 1800);
  // 目标格点亮 —— 与拖动时的「可滑动格」用同一套视觉，玩家一看就懂
  const bgs = document.getElementById('board').querySelectorAll('.cellbg');
  const tg = bgs[s.r*G.cols + s.c];
  if (tg) tg.classList.add('reach');
  setTimeout(()=>{ if (tg) tg.classList.remove('reach'); }, 1800);
  drawLink({r:s.r, c:s.c}, s.hit, 'rgba(46,122,112,.95)');
  setTimeout(clearSvg, 1800);
  const dir = (s.r === s.tile.r) ? '横向' : '纵向';
  toast('把「' + s.tile.char + '」' + dir + '滑到亮起的格子<br>即可与「' + s.hit.char + '」拼成「' + pairWord(s.tile, s.hit) + '」', 2600);
}
/* 洗牌 · 只负责重排，不做判定 */
function shuffleBoard(){
  const ts = allTiles();
  const slots = shuffle([...Array(G.cols*G.rows).keys()]).slice(0, ts.length);
  G.board = new Array(G.cols*G.rows).fill(null);
  ts.forEach((t,i)=>{
    const idx = slots[i];
    t.r = Math.floor(idx/G.cols); t.c = idx % G.cols;
    G.board[idx] = t;
  });
  ts.forEach(t=>placeEl(t, true));
}
/* 洗牌道具。isFree = true 时走「死局兜底」，不扣次数。
   ★ 重排后必须保证新盘面「还能继续玩」：滑动约束一旦加上，
     随便重排有可能排出一个既点不动、也滑不动的死盘。
     所以最多重排 20 次，直到 hasDirectMatch() 或 findSuggest() 成立。 */
function useShuffle(isFree){
  if (!isFree){
    if (G.stats.shuffle <= 0 || G.busy) return;
    G.stats.shuffle--;
  }
  renderTools();
  const btn = document.getElementById('t-shuffle');
  if (btn) btn.classList.remove('glow');
  let ok = false;
  for (let k = 0; k < 20; k++){
    shuffleBoard();
    if (hasDirectMatch() || findSuggest()){ ok = true; break; }
  }
  toast('盘面已重排');
  setTimeout(checkDeadlock, 400);
  return ok;
}
function useBomb(){
  if (G.stats.bomb <= 0 || G.busy) return;
  const ts = allTiles().filter(t=>t.kind !== 'junk');
  let found = null;
  for (let i=0;i<ts.length && !found;i++)
    for (let j=i+1;j<ts.length;j++)
      if (canPair(ts[i],ts[j])){ found = [ts[i], ts[j]]; break; }
  if (!found){ toast('场上没有可合成的两张牌了'); return; }
  G.stats.bomb--;
  renderTools();
  resolveMatch(found[0], found[1]);
}

/* ---------- 6.9 结算 ---------- */
function finishClear(){
  stopTimer();
  G.busy = true;
  const total = curLevel.time;
  const left = Math.max(0, G.t);
  const ratio = left / total;
  const stars = ratio > 0.5 ? 3 : (ratio > 0.2 ? 2 : 1);
  G.stars[curLv] = Math.max(G.stars[curLv] || 0, stars);
  runWords.forEach(x=>{ G.litWords[x.w] = 1; });
  save();
  const st = document.getElementById('res-stars');
  st.innerHTML = [1,2,3].map(i=> i<=stars ? '<i>★</i>' : '<i class="off">★</i>').join('');
  document.getElementById('res-title').textContent = stars===3 ? '妙手成字' : (stars===2 ? '顺利通关' : '惊险过关');
  document.getElementById('res-time').textContent = Math.round(total-left) + 's';
  document.getElementById('res-move').textContent = G.stats.move;
  document.getElementById('res-word').textContent = matchedWords.length;
  document.getElementById('word-showcase').innerHTML = runWords.slice(0,4).map(x=>{
    const w = WORDS[x.w];
    return '<div class="ws-row">' +
      '<span class="ws-piece r">' + w.a + '</span>' +
      '<span class="ws-op">+</span>' +
      '<span class="ws-piece p">' + w.b + '</span>' +
      '<span class="ws-eq">＝</span>' +
      '<span class="ws-piece w">' + x.w + '</span></div>';
  }).join('');
  go('s-clear');
}
function finishFail(){
  stopTimer();
  G.busy = true;
  document.getElementById('fail-word').textContent = G.stats.matched;
  document.getElementById('fail-left').textContent = allTiles().filter(t=>t.kind!=='junk').length;
  go('s-fail');
}
function revive(){
  G.deadline = Date.now() + 30000;
  G.t = 30;
  document.getElementById('timer').classList.remove('warn');
  startTimer();
  G.busy = false;
  go('s-play');
  toast('复活成功，+30 秒');
}
function nextLevel(){
  const nx = curLv + 1;
  if (nx > LEVELS.length){ toast('已通关全部章节，期待更多字'); go('s-home'); return; }
  startLevel(nx);
}

/* ---------- 6.10 自动演示（评审/自测用） ---------- */
/* 等盘面真正渲染出来再执行。
   renderBoard() 跑在两帧 rAF 之后；而用 --virtual-time-budget 截图时 setTimeout 会被
   瞬间推进，直接调 demoDrag/autoPlay 会抢在 renderBoard 前面 —— 那时 #board 还是空的，
   随后的重建会把加好的样式全部抹掉（现象：截图里看不到拖动效果，但控制台手动调用却正常）。 */
function afterBoardReady(fn, tries){
  tries = tries || 0;
  const ready = document.getElementById('board').querySelector('.tile');
  if (!ready && tries < 90){ requestAnimationFrame(()=>afterBoardReady(fn, tries+1)); return; }
  fn();
}
function autoPlay(){
  const play = document.getElementById('s-play');
  const step = ()=>{
    if (!play.classList.contains('active')) return;
    if (G.busy){ setTimeout(step, 200); return; }
    if (!allTiles().filter(t=>t.kind!=='junk').length) return;
    const s = findSuggest();
    if (!s){ toast('自动演示：无可挪动组合'); return; }
    moveTile(s.tile, s.r, s.c, true);
    setTimeout(step, 900);
  };
  setTimeout(step, 600);
}
/* 截图用：摆出「拖到一半」的状态（评审看拖动反馈） */
function demoDrag(){
  const s = findSuggest();
  if (!s || !s.tile.el) return;
  const t = s.tile, el = t.el;
  const horiz = (s.r === t.r);
  markReachable(slideRange(t), t);            // 展示「本行/本列能滑到哪」
  el.classList.add('dragging');
  el.style.transition = 'none';
  // 沿滑动轴偏移（不再往斜上方飘 —— 那会让人误以为可以斜着挪）
  tileXY(el, s.c*G.cell + G.gap/2 - (horiz ? G.cell*0.30 : 0),
              s.r*G.cell + G.gap/2 - (horiz ? 0 : G.cell*0.30),
         'scale(1.1) rotate(' + (horiz ? -4 : 0) + 'deg)');
  if (s.hit.el) s.hit.el.classList.add('hl');
  drawLink({r:s.r, c:s.c}, s.hit, 'rgba(200,160,46,.9)');
}
</script>
</body>
</html>
