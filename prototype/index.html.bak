<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no">
<title>挪字成章 · 可点击原型 v2.2</title>
<style>
/* ============================================================
   挪字成章 · 原型 v2.2
   玩法：挪对（字牌只能沿本行/本列滑动、遇牌即停 → 同行同列无障碍对齐 → 配对合成汉字）
   风格：国风宣纸 · 墨韵 · 朱砂青玉双色牌
   ============================================================ */
:root{
  --paper:#F8F3E7;
  --paper-d:#EDE4D2;
  --ink:#2B2620;
  --ink2:#8B8478;
  --ink3:#B3AC9F;
  --red:#B5352A;
  --red-d:#8E281F;
  --gold:#C8A02E;
  --gold-l:#E5CB74;
  --jade:#2E7A70;
  --jade-l:#57A79B;
  --line:#DED3BB;
  --cell:#E7DDC8;
  --kai:"STKaiti","Kaiti SC","KaiTi","Kaiti TC","Songti SC","SimSun",serif;
  --hei:-apple-system,"PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html,body{margin:0;padding:0;}
body{
  background:#D6CEBD;
  font-family:var(--hei);
  color:var(--ink);
  display:flex;align-items:center;justify-content:center;
  padding:14px;min-height:100vh;
}
/* ==================== 手机外框 + 宣纸底 ==================== */
.phone{
  width:390px;height:780px;max-height:calc(100vh - 28px);
  border-radius:30px;overflow:hidden;position:relative;
  border:9px solid #241F1A;
  background:radial-gradient(120% 80% at 50% 0%,#FCF8EF 0%,#F6F0E2 45%,#EDE4D2 100%);
  box-shadow:0 22px 60px rgba(60,45,25,.32),0 0 0 1px rgba(120,100,70,.18);
}
.phone::before{
  content:'';position:absolute;inset:0;pointer-events:none;z-index:0;opacity:.85;
  background-image:
    repeating-linear-gradient(0deg,rgba(150,130,95,.05) 0 1px,transparent 1px 3px),
    repeating-linear-gradient(90deg,rgba(150,130,95,.038) 0 1px,transparent 1px 4px);
}
.screen{position:absolute;inset:0;display:none;flex-direction:column;overflow:hidden;z-index:1;}
.screen.active{display:flex;}

/* ==================== 通用控件 ==================== */
.topbar{flex:0 0 auto;display:flex;align-items:center;gap:10px;padding:16px 16px 8px;}
.btn-back{
  width:32px;height:32px;border-radius:50%;border:1px solid rgba(150,130,95,.3);
  background:rgba(255,255,255,.7);font-size:15px;color:var(--ink);cursor:pointer;
  display:flex;align-items:center;justify-content:center;font-family:inherit;
  box-shadow:0 1px 3px rgba(120,100,60,.1);transition:transform .08s;
}
.btn-back:active{transform:scale(.92);}
.grow{flex:1;}
.btn{
  border:none;border-radius:15px;color:#fff;font-size:17px;font-weight:700;
  padding:15px;width:100%;cursor:pointer;font-family:inherit;
  background:linear-gradient(168deg,#C4412F,#9E2C21);
  box-shadow:0 4px 0 rgba(120,30,20,.35),0 6px 16px rgba(160,50,35,.28);
  transition:transform .08s,box-shadow .08s;letter-spacing:1px;
}
.btn:active{transform:translateY(2px);box-shadow:0 2px 0 rgba(120,30,20,.35),0 3px 10px rgba(160,50,35,.22);}
.btn.ghost{
  background:rgba(255,255,255,.78);color:var(--ink);
  box-shadow:0 1px 3px rgba(120,100,60,.14),0 0 0 1px rgba(150,130,95,.2);
  font-size:15px;font-weight:600;
}
.btn.ghost:active{transform:translateY(1px);box-shadow:0 1px 2px rgba(120,100,60,.14);}
.card{
  background:rgba(255,255,255,.82);border-radius:16px;padding:14px;margin:0 16px 12px;
  box-shadow:0 2px 10px rgba(120,100,60,.1),0 0 0 1px rgba(150,130,95,.13);
}
.muted{color:var(--ink2);font-size:13px;}
.center{text-align:center;}

/* ==================== S01 启动页 ==================== */
#s-boot{align-items:center;justify-content:center;}
.seal{
  width:118px;height:118px;border-radius:20px;position:relative;
  background:linear-gradient(148deg,#C4412F,#8E281F);
  display:flex;align-items:center;justify-content:center;flex-direction:column;
  box-shadow:0 14px 34px rgba(160,50,35,.36),inset 0 2px 0 rgba(255,255,255,.22);
}
.seal::after{
  content:'';position:absolute;inset:7px;border-radius:14px;
  border:1.5px solid rgba(255,255,255,.42);
}
.seal b{font-family:var(--kai);font-size:30px;color:#fff;line-height:1.06;font-weight:700;letter-spacing:1px;}
.boot-title{margin-top:24px;font-family:var(--kai);font-size:30px;font-weight:700;letter-spacing:10px;text-indent:10px;}
.boot-sub{margin-top:8px;font-size:12px;color:var(--ink2);letter-spacing:4px;text-indent:4px;}
.bar{width:186px;height:6px;border-radius:99px;background:rgba(140,120,85,.16);overflow:hidden;margin-top:30px;}
.bar>i{display:block;height:100%;width:0;border-radius:99px;background:linear-gradient(90deg,var(--gold),var(--red));transition:width .22s;}
.boot-tip{position:absolute;bottom:34px;font-size:10.5px;color:var(--ink3);line-height:1.9;text-align:center;width:100%;}

/* ==================== S02 首页 ==================== */
.home-wrap{padding:0 22px;display:flex;flex-direction:column;height:100%;}
.home-hero{margin:52px 0 0;text-align:center;position:relative;}
.home-hero .lotus{font-family:var(--kai);font-size:15px;color:var(--ink3);letter-spacing:8px;text-indent:8px;}
.home-title{
  font-family:var(--kai);font-size:44px;font-weight:700;letter-spacing:10px;text-indent:10px;
  margin:12px 0 0;color:#2B2620;
}
.home-title em{color:var(--red);font-style:normal;}
.home-rule{
  margin-top:16px;font-size:12.5px;color:var(--ink2);letter-spacing:1.6px;line-height:2;
}
.home-rule b{color:var(--red);font-weight:600;}
.home-menu{margin-top:auto;margin-bottom:26px;display:flex;flex-direction:column;gap:11px;}
.home-row{display:flex;gap:11px;}
.home-stat{display:flex;justify-content:center;gap:22px;margin-bottom:16px;font-size:12px;color:var(--ink2);}
.home-stat b{display:block;font-family:var(--kai);font-size:21px;color:var(--red);text-align:center;font-weight:700;}
.home-demo{display:flex;align-items:center;justify-content:center;gap:9px;margin-top:30px;}
.hd-piece{
  font-family:var(--kai);font-size:26px;font-weight:700;width:52px;height:52px;
  display:flex;align-items:center;justify-content:center;border-radius:13px;
}
.hd-piece.r{background:linear-gradient(158deg,#FDEFD6,#F2D9AE);color:#8A4715;
  box-shadow:inset 0 -2px 0 rgba(170,115,45,.25),0 3px 9px rgba(140,100,45,.22);}
.hd-piece.p{background:linear-gradient(158deg,#E8F4F1,#CDE5DF);color:#1C5A50;
  box-shadow:inset 0 -2px 0 rgba(30,110,100,.2),0 3px 9px rgba(45,95,85,.2);}
.hd-piece.w{background:linear-gradient(158deg,#C4412F,#93291E);color:#fff;
  box-shadow:0 5px 14px rgba(160,50,35,.34);}
.hd-op{font-size:17px;color:var(--ink3);}
/* 首页 · 收录一览（填补中部留白） */
.home-intro{margin:auto 0 0;padding:0 4px;text-align:center;}
.hi-title{font-size:12px;color:var(--ink2);letter-spacing:1px;}
.hi-title b{font-family:var(--kai);font-size:15.5px;color:var(--red);font-weight:700;}
.hi-tiles{display:flex;flex-wrap:wrap;justify-content:center;gap:6px;margin:13px 0 11px;}
.hi-tiles span{
  font-family:var(--kai);font-size:15px;font-weight:700;color:#5C5245;
  width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;
  background:rgba(255,255,255,.84);
  box-shadow:inset 0 -2px 0 rgba(170,140,90,.16),0 2px 6px rgba(120,100,60,.14),0 0 0 1px rgba(150,130,95,.16);
}
.hi-note{font-size:11px;color:var(--ink3);letter-spacing:2.4px;}

/* ==================== S03 章节选择 ==================== */
.chap-list{flex:1;overflow-y:auto;padding-bottom:24px;}
.chap{
  background:rgba(255,255,255,.86);border-radius:17px;padding:15px 16px;margin:0 16px 12px;
  box-shadow:0 2px 10px rgba(120,100,60,.1),0 0 0 1px rgba(150,130,95,.13);
  cursor:pointer;position:relative;overflow:hidden;transition:transform .1s;
}
.chap:active{transform:scale(.985);}
.chap::before{content:'';position:absolute;left:0;top:0;bottom:0;width:4px;background:linear-gradient(180deg,var(--red),var(--gold));}
.chap.locked{opacity:.5;filter:grayscale(.7);cursor:not-allowed;}
.chap h3{margin:0 0 3px;font-family:var(--kai);font-size:19px;letter-spacing:2px;}
.chap .preview{margin-top:7px;font-family:var(--kai);font-size:15px;color:var(--ink2);letter-spacing:5px;}
.chap .meta{display:flex;align-items:center;justify-content:space-between;margin-top:9px;}
.chap .stars{color:var(--gold);font-size:14px;letter-spacing:1.5px;}
.chap .stars .off{color:#D8D1C3;}
.chap .cnt{font-size:11.5px;color:var(--ink3);}

/* ==================== S04 关卡地图 ==================== */
.map-wrap{flex:1;overflow-y:auto;padding:6px 0 30px;position:relative;}
.node-row{display:flex;gap:14px;padding:0 20px;margin-bottom:10px;align-items:center;position:relative;}
.node{
  width:68px;height:68px;border-radius:50%;background:rgba(255,255,255,.86);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  box-shadow:0 3px 12px rgba(120,100,60,.14),0 0 0 1px rgba(150,130,95,.18);
  cursor:pointer;position:relative;transition:transform .1s;z-index:1;
}
.node:active{transform:scale(.94);}
.node .n-id{font-family:var(--kai);font-size:19px;font-weight:700;}
.node .n-st{font-size:9px;color:var(--gold);letter-spacing:-.5px;height:11px;}
.node.done{background:linear-gradient(160deg,#FFFDF6,#FBF2D9);box-shadow:0 3px 12px rgba(160,130,50,.18),0 0 0 2px rgba(200,160,46,.42);}
.node.cur{background:#fff;box-shadow:0 3px 14px rgba(181,53,42,.3),0 0 0 2.5px var(--red);animation:pulse 1.6s infinite;}
@keyframes pulse{0%,100%{box-shadow:0 3px 14px rgba(181,53,42,.28),0 0 0 2.5px var(--red);}50%{box-shadow:0 3px 14px rgba(181,53,42,.18),0 0 0 8px rgba(181,53,42,0);}}
.node.locked{opacity:.4;filter:grayscale(1);cursor:not-allowed;}
.map-info{padding:2px 20px 12px;font-size:12px;color:var(--ink2);}

/* ==================== S05 主玩法 ==================== */
#s-play{background:radial-gradient(120% 70% at 50% 0%,#FCF8EF,#F3ECDC 60%,#EAE0CB);}
.play-top{flex:0 0 auto;display:flex;align-items:center;gap:9px;padding:13px 14px 4px;}
.play-title{font-family:var(--kai);font-size:15px;font-weight:700;letter-spacing:1px;}
.timer{font-size:16px;font-weight:800;font-variant-numeric:tabular-nums;letter-spacing:.5px;color:var(--jade);}
.timer.warn{color:var(--red);animation:blink .85s infinite;}
@keyframes blink{50%{opacity:.3;}}
.goal-bar{flex:0 0 auto;display:flex;gap:7px;padding:4px 14px 8px;justify-content:center;flex-wrap:wrap;}
.goal-chip{
  display:flex;align-items:center;gap:5px;padding:4px 9px;border-radius:10px;
  background:rgba(255,255,255,.72);border:1px solid rgba(150,130,95,.22);
  box-shadow:0 1px 3px rgba(120,100,60,.08);transition:all .25s;
}
.goal-chip .g-word{font-family:var(--kai);font-size:18px;font-weight:700;color:#5C5245;line-height:1;}
.goal-chip .g-num{font-size:11px;color:var(--ink2);font-variant-numeric:tabular-nums;}
.goal-chip.done{background:linear-gradient(160deg,#FDF3D8,#F5E0A8);border-color:rgba(200,160,46,.55);box-shadow:0 2px 8px rgba(200,160,46,.28);}
.goal-chip.done .g-word{color:var(--red);}
.goal-chip.done .g-num{color:#96751A;}
.board-wrap{flex:1 1 auto;display:flex;align-items:center;justify-content:center;padding:2px 10px;min-height:0;}
/* 案几：深墨色。宣纸牌摊在上面才「浮」得起来 ——
   浅底上宣纸会和背景糊成一片，整套水墨就白做了。 */
.board{
  position:relative;border-radius:8px;
  background:#23262c;
  box-shadow:inset 0 0 64px rgba(0,0,0,.55),0 6px 20px rgba(40,30,15,.28);
  touch-action:none;
}
/* 空格：平时不显形（水墨画面里不该有格子线），只在揭示可滑动范围时亮起来 */
.cellbg{position:absolute;border-radius:6px;background:transparent;}
/* 拿起一张牌时，把它「本行/本列能滑到的空格」点亮 —— 空格稀缺时玩家必须一眼看出可动范围。
   太淡等于没有（实测在宣纸米色底上几乎看不见），所以底色 + 双线描边 + 中心提示点三件套。 */
.cellbg.reach{
  background:rgba(206,160,44,.22);
  box-shadow:inset 0 0 0 2px rgba(190,144,32,.62),inset 0 1px 2px rgba(120,100,60,.06);
  animation:reachIn .18s ease-out;
}
.cellbg.reach::after{
  content:'';position:absolute;left:50%;top:50%;width:7px;height:7px;
  margin:-3.5px 0 0 -3.5px;border-radius:50%;background:rgba(172,126,20,.48);
}
@keyframes reachIn{from{background:rgba(206,160,44,.04);}to{background:rgba(206,160,44,.22);}}
.svg-layer{position:absolute;inset:0;pointer-events:none;overflow:visible;z-index:40;}
/* ── 牌面：一张宣纸（水墨 SVG 渲染，见 design/ink-tile.js）──
   ★ 位置一律走 transform:translate，绝不用 left/top。
     实测：改 left/top 会每帧重排+重绘，水墨牌面的 filter 跟着重算，
     帧率从 60fps 掉到 39fps；走 transform 只动合成层，filter 只算一次。 */
.tile{
  position:absolute;left:0;top:0;
  will-change:transform;cursor:grab;
  user-select:none;-webkit-user-select:none;touch-action:none;
  transition:transform .17s cubic-bezier(.2,.85,.3,1.15),opacity .2s;
}
.tile svg{width:100%;height:100%;display:block;border-radius:2px;overflow:hidden;}
/* 干扰牌：字淡、面暗、一道朱砂斜划 —— 用水墨的语言说「这张拼不成字」，
   比原来的灰底 + 灰斜杠更贴整体风格，信息一样清楚。
   （偏旁牌与部件牌不再用暖/冷双色区分：配对表是无序的，颜色本来就不带玩法信息，
     染成两色恰恰是「彩色贴纸」那股味。） */
.tile.junk svg{opacity:.55;}
.tile.junk::after{
  content:'';position:absolute;left:9%;right:9%;top:50%;height:2px;border-radius:2px;
  background:rgba(155,62,45,.52);transform:rotate(-34deg);
}
.tile.dragging{
  z-index:70;cursor:grabbing;
  box-shadow:0 15px 28px rgba(0,0,0,.52);   /* 纸被拎起来了，离案几远了 */
}
.tile.hl{
  box-shadow:0 0 0 2.5px rgba(206,160,44,.95),0 0 18px rgba(206,160,44,.7);
  animation:hlpulse 1s infinite;
}
@keyframes hlpulse{0%,100%{filter:brightness(1);}50%{filter:brightness(1.13);}}
.tile.hint{box-shadow:0 0 0 2.5px rgba(70,150,140,.9),0 0 18px rgba(70,150,140,.6);}
.tile.shake{animation:shake .32s;}
@keyframes shake{0%,100%{margin-left:0;}25%{margin-left:-5px;}75%{margin-left:5px;}}
.tile.pop{opacity:0;}

/* 合成的那个字从两牌中点浮现 —— 也是一张水墨牌，只是不留印 */
.melt{position:absolute;left:0;top:0;z-index:80;pointer-events:none;
  will-change:transform,opacity;}
.melt svg{width:100%;height:100%;display:block;}

.tool-bar{flex:0 0 auto;display:flex;gap:10px;padding:8px 14px 16px;}
.tool{
  flex:1;border:1px solid rgba(150,130,95,.24);border-radius:14px;cursor:pointer;
  background:rgba(255,255,255,.8);font-family:inherit;font-size:12.5px;color:#5C5245;
  padding:9px 4px 8px;display:flex;flex-direction:column;align-items:center;gap:2px;
  box-shadow:0 2px 6px rgba(120,100,60,.1);transition:transform .08s;
}
.tool:active{transform:translateY(1px);}
.tool b{font-family:var(--kai);font-size:21px;font-weight:700;color:var(--red);line-height:1.05;}
.tool span{font-size:11.5px;color:#5C5245;letter-spacing:.5px;}
.tool:disabled{opacity:.42;cursor:not-allowed;}
.tool.glow{animation:toolglow 1.6s infinite;}
@keyframes toolglow{0%,100%{box-shadow:0 2px 6px rgba(120,100,60,.1);}50%{box-shadow:0 2px 14px rgba(200,160,46,.75);}}

/* 结构提示条 */
.tips{
  flex:0 0 auto;margin:0 14px 4px;padding:7px 12px;border-radius:12px;
  background:rgba(200,160,46,.13);border:1px dashed rgba(200,160,46,.5);
  font-family:var(--kai);font-size:14px;color:#7A5F14;text-align:center;letter-spacing:1.5px;
  display:none;
}
.tips.show{display:block;}

/* 已成字：本关合成成果，展示拆解但不剧透未合成的字 */
.made-strip{
  flex:0 0 auto;margin:0 14px 8px;height:62px;
  border-radius:14px;background:rgba(255,255,255,.5);
  box-shadow:inset 0 0 0 1px rgba(150,130,95,.15);
  display:flex;align-items:center;gap:7px;padding:0 9px;
  overflow-x:auto;overflow-y:hidden;
}
.made-strip::-webkit-scrollbar{display:none;}
.ms-empty{width:100%;text-align:center;font-size:11.5px;color:var(--ink3);line-height:1.65;letter-spacing:.3px;}
.ms-empty b{color:var(--red);font-weight:600;}
.ms-card{
  flex:0 0 auto;display:flex;align-items:center;gap:3px;padding:5px 7px;border-radius:10px;
  background:linear-gradient(160deg,#FFFDF6,#F7EBD2);
  box-shadow:0 2px 7px rgba(200,160,46,.2),0 0 0 1px rgba(200,160,46,.4);
  animation:cardin .3s backwards;
}
@keyframes cardin{from{transform:scale(.7);opacity:0;}to{transform:scale(1);opacity:1;}}
.ms-p{font-family:var(--kai);font-size:15px;font-weight:700;width:25px;height:25px;
  display:flex;align-items:center;justify-content:center;border-radius:7px;}
.ms-p.r{background:linear-gradient(158deg,#FDEFD6,#F2D9AE);color:#8A4715;}
.ms-p.p{background:linear-gradient(158deg,#E8F4F1,#CDE5DF);color:#1C5A50;}
.ms-p.w{font-size:16px;color:#fff;background:linear-gradient(158deg,#C4412F,#93291E);}
.ms-op{font-size:11px;color:var(--ink3);}

/* ==================== S06/S07 结算 ==================== */
#s-clear,#s-fail{align-items:center;justify-content:center;padding:0 24px;}
.res-panel{width:100%;text-align:center;}
.res-tag{font-family:var(--kai);font-size:15px;color:var(--ink2);letter-spacing:7px;text-indent:7px;}
.res-stars{font-size:34px;color:var(--gold);letter-spacing:8px;margin:12px 0 6px;text-shadow:0 3px 10px rgba(200,160,46,.4);}
.res-stars .off{color:#DCD5C6;text-shadow:none;}
.res-stars i{display:inline-block;font-style:normal;animation:starpop .5s backwards;}
.res-stars i:nth-child(1){animation-delay:.15s;}
.res-stars i:nth-child(2){animation-delay:.3s;}
.res-stars i:nth-child(3){animation-delay:.45s;}
@keyframes starpop{from{transform:scale(0) rotate(-45deg);opacity:0;}to{transform:scale(1) rotate(0);opacity:1;}}
.res-title{font-family:var(--kai);font-size:25px;font-weight:700;letter-spacing:4px;margin:4px 0 18px;}
.word-showcase{
  background:rgba(255,255,255,.8);border-radius:18px;padding:16px 14px;margin:0 auto 18px;
  box-shadow:0 3px 14px rgba(120,100,60,.12),0 0 0 1px rgba(150,130,95,.16);max-width:300px;
}
.ws-row{display:flex;align-items:center;justify-content:center;gap:10px;padding:7px 0;}
.ws-row+.ws-row{border-top:1px dashed rgba(150,130,95,.3);}
.ws-piece{
  font-family:var(--kai);font-size:22px;font-weight:700;width:44px;height:44px;
  display:flex;align-items:center;justify-content:center;border-radius:10px;
}
.ws-piece.r{background:linear-gradient(158deg,#FDEFD6,#F2D9AE);color:#8A4715;box-shadow:inset 0 -2px 0 rgba(170,115,45,.25),0 2px 5px rgba(140,100,45,.18);}
.ws-piece.p{background:linear-gradient(158deg,#E8F4F1,#CDE5DF);color:#1C5A50;box-shadow:inset 0 -2px 0 rgba(30,110,100,.2),0 2px 5px rgba(45,95,85,.16);}
.ws-op{font-size:17px;color:var(--ink3);}
.ws-eq{font-size:17px;color:var(--ink3);}
.ws-piece.w{
  font-size:26px;color:#fff;background:linear-gradient(158deg,#C4412F,#93291E);
  box-shadow:0 3px 10px rgba(160,50,35,.34);
}
.res-stats{display:flex;justify-content:center;gap:26px;margin-bottom:22px;font-size:12px;color:var(--ink2);}
.res-stats b{display:block;font-family:var(--kai);font-size:20px;color:var(--red);font-weight:700;}
.res-btns{display:flex;flex-direction:column;gap:10px;}

/* ==================== S08 图鉴 ==================== */
.atlas-wrap{flex:1;overflow-y:auto;padding-bottom:24px;}
.atlas-sec{padding:0 16px 6px;font-family:var(--kai);font-size:15px;color:var(--ink2);letter-spacing:2px;margin-top:6px;}
.atlas-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;padding:0 16px 14px;}
.aw{
  aspect-ratio:1/1;border-radius:12px;display:flex;flex-direction:column;
  align-items:center;justify-content:center;gap:2px;position:relative;
  background:rgba(255,255,255,.8);box-shadow:0 2px 8px rgba(120,100,60,.1),0 0 0 1px rgba(150,130,95,.14);transition:all .2s;
}
.aw.lit{background:linear-gradient(158deg,#FFFDF6,#F7EBD2);box-shadow:0 2px 10px rgba(200,160,46,.3),0 0 0 1.5px rgba(200,160,46,.5);}
.aw .w{font-family:var(--kai);font-size:25px;font-weight:700;color:#C4BCAD;}
.aw.lit .w{color:var(--red);}
.aw .py{font-size:9px;color:var(--ink3);letter-spacing:.5px;}
.aw.lit .py{color:#9A7A1E;}
.aw .lock{font-size:19px;color:#CFC7B7;}

/* ==================== S09 设置 ==================== */
.set-row{
  display:flex;align-items:center;justify-content:space-between;
  padding:13px 14px;background:rgba(255,255,255,.8);border-radius:14px;margin:0 16px 10px;
  box-shadow:0 2px 8px rgba(120,100,60,.09),0 0 0 1px rgba(150,130,95,.13);font-size:14.5px;
}
.sw{width:46px;height:26px;border-radius:99px;background:#CFC8B9;position:relative;cursor:pointer;transition:background .2s;flex:0 0 auto;}
.sw::after{content:'';position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.2);transition:left .2s;}
.sw.on{background:var(--jade);}
.sw.on::after{left:23px;}

/* ==================== Toast / Modal ==================== */
.toast{
  position:absolute;left:50%;top:52%;transform:translate(-50%,-50%) scale(.94);
  background:rgba(43,38,32,.92);color:#F6F0E2;font-size:13px;line-height:1.6;
  padding:11px 17px;border-radius:13px;opacity:0;pointer-events:none;
  transition:opacity .2s,transform .2s;z-index:200;max-width:80%;text-align:center;
  box-shadow:0 8px 24px rgba(0,0,0,.28);
}
.toast.show{opacity:1;transform:translate(-50%,-50%) scale(1);}
.mask{position:absolute;inset:0;background:rgba(43,38,32,.5);z-index:180;display:none;align-items:center;justify-content:center;padding:0 34px;backdrop-filter:blur(2px);}
.mask.show{display:flex;}
.dlg{background:#FBF7EE;border-radius:20px;padding:22px 20px 18px;width:100%;box-shadow:0 20px 50px rgba(0,0,0,.3);text-align:center;}
.dlg h3{margin:0 0 8px;font-family:var(--kai);font-size:20px;letter-spacing:2px;}
.dlg p{margin:0 0 16px;font-size:13px;color:var(--ink2);line-height:1.7;}
.dlg-btns{display:flex;flex-direction:column;gap:9px;}
</style>
</head>
<body>
<!-- ==INLINE-DEFS-BEGIN== 由 tools/inline-assets.py 注入，勿手改 -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
  <!-- 蘸一次墨写到底：起笔墨浓，末笔墨淡。
       ★ 末梢刻意压掉蓝调（原 #636973 的 b=115 > r=99，是真墨不该有的冷色）。 -->
  <linearGradient id="moGrad" x1="0.02" y1="0" x2="0.98" y2="1">
    <stop offset="0" stop-color="#0c0d0e"/>
    <stop offset="0.34" stop-color="#191a1c"/>
    <stop offset="0.66" stop-color="#2b2d2f"/>
    <stop offset="0.88" stop-color="#454743"/>
    <stop offset="1" stop-color="#66665f"/>
  </linearGradient>

  <!-- 墨（字）：毛边 + 双副本错位叠墨（浓墨主体 + 淡墨洇影）+ 渗化晕 -->
  <filter id="inkMo" x="-22%" y="-22%" width="144%" height="144%" color-interpolation-filters="sRGB">
    <feTurbulence type="fractalNoise" baseFrequency="0.018 0.026" numOctaves="4" seed="9" result="e1"/>
    <feDisplacementMap in="SourceGraphic" in2="e1" scale="7" xChannelSelector="R" yChannelSelector="G" result="A"/>
    <feTurbulence type="fractalNoise" baseFrequency="0.010 0.016" numOctaves="3" seed="23" result="e2"/>
    <feDisplacementMap in="SourceGraphic" in2="e2" scale="15" xChannelSelector="R" yChannelSelector="G" result="B"/>
    <feColorMatrix in="B" type="matrix" result="Bh"
      values="0 0 0 0 0.40  0 0 0 0 0.42  0 0 0 0 0.46  0 0 0 .58 0"/>
    <feOffset in="Bh" dx="-5" dy="-4" result="Bo"/>
    <feGaussianBlur in="Bo" stdDeviation="5" result="h0"/>
    <feComponentTransfer in="h0" result="hl0"><feFuncA type="linear" slope="0.16"/></feComponentTransfer>
    <feGaussianBlur in="A" stdDeviation="1.3" result="h1"/>
    <feComponentTransfer in="h1" result="hl1"><feFuncA type="linear" slope="0.34"/></feComponentTransfer>
    <feMerge><feMergeNode in="hl0"/><feMergeNode in="Bo"/><feMergeNode in="hl1"/><feMergeNode in="A"/></feMerge>
  </filter>

  <!-- 墨（物象笔触）：★ 与字「同一种笔」，只是墨少。
   *
   * 上一版翻车的原因：给了它 stdDeviation 1.1 + 0.45 两层高斯模糊 ——
   * 字是锐的、物象是糊的，一锐一糊对比之下，物象就读成「污渍 / 灰虫子」。
   * 淡不是糊。真正该淡的是「墨量」（用 TONE 的颜色 + 组 opacity 控制），
   * 边缘必须和字一样锐，而且要更毛（飞白）。
   *
   * 所以这里只留一层极轻的渗化（0.5，低 slope，只为了边不发"塑料"），
   * 位移放大到 10 制造飞白毛边，主体完全不模糊。 -->
  <filter id="inkWu" x="-30%" y="-30%" width="160%" height="160%" color-interpolation-filters="sRGB">
    <feTurbulence type="fractalNoise" baseFrequency="0.03 0.045" numOctaves="4" seed="17" result="e"/>
    <feDisplacementMap in="SourceGraphic" in2="e" scale="10" xChannelSelector="R" yChannelSelector="G" result="r"/>
    <feGaussianBlur in="r" stdDeviation="0.5" result="b"/>
    <feComponentTransfer in="b" result="h"><feFuncA type="linear" slope="0.2"/></feComponentTransfer>
    <feMerge><feMergeNode in="h"/><feMergeNode in="r"/></feMerge>
  </filter>

  <!-- 小尺寸用的轻滤镜：牌面只有几十像素时，重滤镜会糊成一团 -->
  <filter id="inkMini" x="-20%" y="-20%" width="140%" height="140%" color-interpolation-filters="sRGB">
    <feTurbulence type="fractalNoise" baseFrequency="0.05 0.07" numOctaves="3" seed="9" result="e"/>
    <feDisplacementMap in="SourceGraphic" in2="e" scale="4" xChannelSelector="R" yChannelSelector="G" result="r"/>
    <feGaussianBlur in="r" stdDeviation="1.4" result="b"/>
    <feComponentTransfer in="b" result="h"><feFuncA type="linear" slope="0.3"/></feComponentTransfer>
    <feMerge><feMergeNode in="h"/><feMergeNode in="r"/></feMerge>
  </filter>

  <!-- ══════════════════ 牌面：纸的质感 ══════════════════
   * 三条都是「让方块不像方块」的低频/高频噪声：
   *   陈纸  —— 极低频，给整张纸一点不均匀的明暗，消掉平涂感
   *   纤维  —— x 频率极低、y 频率极高 → 拉出丝缕状的纸纹（帘纹）
   *   墨韵  —— 大位移把边缘打散，模拟墨在纸上「晕开」的不规则边界
   * 注意：晕染用的大 stdDeviation 在这里是「对的」—— 因为这是背景不是主体。
   * 字锐、景柔，才有景深；上一版把物象画得又锐又小，反而成了脏点。 -->

  <!-- 陈纸：不均匀的明暗 -->
  <filter id="chenZhi" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
    <feTurbulence type="fractalNoise" baseFrequency="0.004 0.006" numOctaves="4" seed="13" result="n"/>
    <feColorMatrix in="n" type="matrix"
      values="0 0 0 0 0.54  0 0 0 0 0.50  0 0 0 0 0.40  0 0 0 0.17 0"/>
  </filter>

  <!-- 帘纹：宣纸抄纸时留下的丝缕 -->
  <filter id="xianWei" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
    <feTurbulence type="fractalNoise" baseFrequency="0.010 0.85" numOctaves="3" seed="7" result="n"/>
    <feColorMatrix in="n" type="matrix"
      values="0 0 0 0 0.44  0 0 0 0 0.41  0 0 0 0 0.33  0 0 0 0.075 0"/>
  </filter>

  <!-- 墨韵：一团墨在纸上晕开。
   * ★ 关键是「里面浓、外面化」——所以用径向渐变给内部浓淡，
   *   而不是靠高斯模糊。上一版直接用 13 的模糊，结果渲出来像水彩云/霉斑；
   *   真水墨是「一笔扫过去」：一段有形的实笔 + 一侧化开的边。
   *   所以：位移大（打散边界）+ 模糊小（保住那一笔的形状）。 -->
  <radialGradient id="yunGrad">
    <stop offset="0" stop-color="#26282a" stop-opacity="1"/>
    <stop offset="0.42" stop-color="#26282a" stop-opacity=".86"/>
    <stop offset="0.74" stop-color="#26282a" stop-opacity=".38"/>
    <stop offset="1" stop-color="#26282a" stop-opacity="0"/>
  </radialGradient>
  <filter id="moYun" x="-30%" y="-30%" width="160%" height="160%" color-interpolation-filters="sRGB">
    <feTurbulence type="fractalNoise" baseFrequency="0.009 0.013" numOctaves="5" seed="31" result="e"/>
    <feDisplacementMap in="SourceGraphic" in2="e" scale="92" xChannelSelector="R" yChannelSelector="G" result="d"/>
    <feGaussianBlur in="d" stdDeviation="6" result="b"/>
    <feComponentTransfer in="b"><feFuncA type="linear" slope="0.72"/></feComponentTransfer>
  </filter>

  <!-- 飞白边：给角落的写意小品用（位移大、保留锐度） -->
  <filter id="feiBai" x="-30%" y="-30%" width="160%" height="160%" color-interpolation-filters="sRGB">
    <feTurbulence type="fractalNoise" baseFrequency="0.024 0.033" numOctaves="4" seed="41" result="e"/>
    <feDisplacementMap in="SourceGraphic" in2="e" scale="26" xChannelSelector="R" yChannelSelector="G"/>
  </filter>
</defs></svg>

<!-- ==INLINE-DEFS-END== -->

<div class="phone" id="phone">

  <!-- S01 启动 -->
  <div class="screen active" id="s-boot">
    <div class="seal"><b>拆字</b><b>挪对</b></div>
    <div class="boot-title">挪字成章</div>
    <div class="boot-sub">偏 旁 相 逢 · 一 挪 成 字</div>
    <div class="bar"><i id="boot-bar"></i></div>
    <div class="boot-tip">原型 v2.2 · 挪对机制版<br>沿本行/本列滑动字牌 → 直线对齐 → 合成汉字</div>
  </div>

  <!-- S02 首页 -->
  <div class="screen" id="s-home">
    <div class="home-wrap">
      <div class="home-hero">
        <div class="lotus">文 · 字 · 拆 · 合</div>
        <div class="home-title">拆字<em>挪对</em></div>
        <div class="home-rule">
          字牌只能沿<b>本行或本列</b>滑动，遇到牌即停<br>
          让偏旁与部件同行同列、中间无挡，即可合成一字
        </div>
        <div class="home-demo">
          <span class="hd-piece r">木</span><span class="hd-op">＋</span>
          <span class="hd-piece p">仓</span><span class="hd-op">＝</span>
          <span class="hd-piece w">枪</span>
        </div>
      </div>
      <div class="home-intro">
        <div class="hi-title">本作收录 <b>103</b> 字 · <b>4</b> 章 · <b>32</b> 关</div>
        <div class="hi-tiles">
          <span>枪</span><span>棍</span><span>棒</span><span>锤</span><span>箭</span><span>鞭</span>
          <span>斧</span><span>梅</span><span>鲤</span><span>蝶</span><span>镜</span><span>炉</span>
        </div>
        <div class="hi-note">十八般兵器 · 花间集 · 逛三园 · 百工坊</div>
      </div>
      <div class="home-menu">
        <div class="home-stat">
          <div><b id="h-stat-star">0</b>已得星</div>
          <div><b id="h-stat-word">0</b>已识字</div>
          <div><b id="h-stat-lv">0</b>已通关</div>
        </div>
        <button class="btn" onclick="go('s-chap')">开始拆字</button>
        <div class="home-row">
          <button class="btn ghost" onclick="renderAtlas();go('s-atlas')">字盘图鉴</button>
          <button class="btn ghost" onclick="go('s-set')">设置</button>
        </div>
      </div>
    </div>
  </div>

  <!-- S03 章节选择 -->
  <div class="screen" id="s-chap">
    <div class="topbar"><button class="btn-back" onclick="go('s-home')">←</button><span style="font-size:15px;font-weight:600">选择章节</span></div>
    <div class="chap-list" id="chap-list"></div>
  </div>

  <!-- S04 关卡地图 -->
  <div class="screen" id="s-map">
    <div class="topbar"><button class="btn-back" onclick="go('s-chap')">←</button><span id="map-title" style="font-size:15px;font-weight:600"></span></div>
    <div class="map-info" id="map-info"></div>
    <div class="map-wrap" id="map-wrap"></div>
  </div>

  <!-- S05 主玩法 -->
  <div class="screen" id="s-play">
    <div class="play-top">
      <button class="btn-back" onclick="exitLevel()">←</button>
      <span class="play-title" id="play-title">第 1 关</span>
      <div class="grow"></div>
      <span class="timer" id="timer">02:00</span>
    </div>
    <div class="goal-bar" id="goal-bar"></div>
    <div class="tips" id="tips"></div>
    <div class="board-wrap">
      <div class="board" id="board">
        <svg class="svg-layer" id="svg-layer" xmlns="http://www.w3.org/2000/svg"></svg>
      </div>
    </div>
    <!-- 已成字：本关已合成的字，展示「偏旁＋部件＝字」的拆解（不剧透未合成字） -->
    <div class="made-strip" id="made-strip"></div>
    <div class="tool-bar">
      <button class="tool" id="t-hint" onclick="useHint()"><b id="n-hint">3</b><span>提示</span></button>
      <button class="tool" id="t-shuffle" onclick="useShuffle()"><b id="n-shuffle">1</b><span>洗牌</span></button>
      <button class="tool" id="t-bomb" onclick="useBomb()"><b id="n-bomb">1</b><span>凑对</span></button>
    </div>
  </div>

  <!-- S06 结算 -->
  <div class="screen" id="s-clear">
    <div class="res-panel">
      <div class="res-tag">字 成</div>
      <div class="res-stars" id="res-stars"></div>
      <div class="res-title" id="res-title">通关</div>
      <div class="word-showcase" id="word-showcase"></div>
      <div class="res-stats">
        <div><b id="res-time">--</b>用时</div>
        <div><b id="res-move">--</b>挪动</div>
        <div><b id="res-word">--</b>成字</div>
      </div>
      <div class="res-btns">
        <button class="btn" onclick="nextLevel()">下一关</button>
        <div class="home-row">
          <button class="btn ghost" onclick="startLevel(curLv)">再来一次</button>
          <button class="btn ghost" onclick="go('s-map');renderMap()">返回地图</button>
        </div>
      </div>
    </div>
  </div>

  <!-- S07 失败 -->
  <div class="screen" id="s-fail">
    <div class="res-panel">
      <div class="res-tag">功 亏 一 篑</div>
      <div class="res-stars">✧ ✧ ✧</div>
      <div class="res-title">时间到了</div>
      <div class="res-stats">
        <div><b id="fail-word">--</b>已成字</div>
        <div><b id="fail-left">--</b>剩余牌</div>
      </div>
      <div class="res-btns">
        <button class="btn" onclick="showAd('复活 +30 秒',()=>revive())">看视频复活</button>
        <button class="btn ghost" onclick="startLevel(curLv)">重来一局</button>
        <button class="btn ghost" onclick="go('s-map');renderMap()">返回地图</button>
      </div>
    </div>
  </div>

  <!-- S08 图鉴 -->
  <div class="screen" id="s-atlas">
    <div class="topbar"><button class="btn-back" onclick="go('s-home')">←</button><span style="font-size:15px;font-weight:600">字盘图鉴</span><div class="grow"></div><span class="muted" id="atlas-cnt"></span></div>
    <div class="atlas-wrap" id="atlas-wrap"></div>
  </div>

  <!-- S09 设置 -->
  <div class="screen" id="s-set">
    <div class="topbar"><button class="btn-back" onclick="go('s-home')">←</button><span style="font-size:15px;font-weight:600">设置</span></div>
    <div style="height:6px"></div>
    <div class="set-row"><span>背景音乐</span><div class="sw on" id="sw-bgm" onclick="toggleSw('sw-bgm')"></div></div>
    <div class="set-row"><span>音效</span><div class="sw on" id="sw-sfx" onclick="toggleSw('sw-sfx')"></div></div>
    <div class="set-row"><span>牌面振动反馈</span><div class="sw on" id="sw-vib" onclick="toggleSw('sw-vib')"></div></div>
    <div class="card" style="margin-top:16px">
      <div class="muted" style="line-height:1.9">
        <b style="color:var(--ink)">玩法速记</b><br>
        ① 看顶部目标字，想它由哪两部分组成<br>
        ② <b style="color:var(--ink)">拖</b>动一张牌 —— 它只能沿<b style="color:var(--ink)">自己所在的这一行或这一列</b>滑动，碰到别的牌就停<br>
        ③ 移动后若与搭档<b style="color:var(--ink)">同一行或同一列、中间无牌挡</b> → 立即合成<br>
        ④ 已经对齐的，<b style="color:var(--ink)">点一下</b>也能消<br>
        ⑤ 拿起字牌时，<b style="color:var(--ink)">亮起来的格子</b>就是它此刻能挪到的地方
      </div>
    </div>
    <div class="muted center" style="margin-top:18px;font-size:11px">挪字成章 · 原型 v2.2<br>本原型仅用于玩法评审，非最终美术</div>
  </div>

  <div class="toast" id="toast"></div>
  <div class="mask" id="mask"><div class="dlg" id="dlg"></div></div>
</div>

<script>
/* ==INLINE-JS-BEGIN== 由 tools/inline-assets.py 注入，勿手改 == */
/* ── glyphs-data.js ── */
/* ============================================================================
 * 挪字成章 · 字形轮廓数据（自动生成，请勿手改）
 * ----------------------------------------------------------------------------
 * 来源：
 *   · 马善政毛笔楷书 (Ma Shan Zheng) — SIL OFL 1.1，未声明保留字体名，
 *     允许转轮廓、修改、商用；分发时需附带版权声明与许可证全文。
 *   · 宋体 (Songti SC, macOS 系统字体) — 仅用于补充 5 个生僻字，
 *     ⚠️ 系统字体**不可随产品分发**，正式发布前必须换成授权字体。
 *
 * 归一化：所有字体先按 upem 归一到 1000，再取**全字库并集包围盒**做统一变换。
 * 绝不可改成逐字适配 —— 那会毁掉「艹在上 / 皿在下」这类结构关系。
 *
 * 字数：298   viewBox：1000   pad：46
 * ========================================================================== */
