/* 建配对索引（无序匹配） */
const PAIR = {};
for (const w in WORDS){ const {a,b} = WORDS[w]; PAIR[a+'|'+b] = w; PAIR[b+'|'+a] = w; }
/* 反向：某字 → 需要的两张牌 */
function needOf(w){ return [WORDS[w].a, WORDS[w].b]; }

/* ============================================================
   2. 关卡表
   ============================================================ */
const CHAPTERS = [
