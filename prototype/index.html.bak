/* ── brush.js ── */
/* ============================================================================
 * 挪字成章 · 写意笔触引擎（毛笔笔触）
 * ----------------------------------------------------------------------------
 * 为什么要引擎而不是手写 path：
 *   一个字要配 2~4 笔物象（根须、枝叶、枪头、红缨…），全项目上百笔。
 *   手写 path 必然风格越画越散，而且「把笔画改粗一点」要动上百处。
 *   引擎把「笔意」参数化：中心线 + 宽度曲线 + 出锋 + 渐隐 + 侧锋。
 *
 * 一根笔触由四件事决定：
 *   ① 中心线   —— 折线控制点，自动过 Catmull-Rom 平滑
 *   ② 宽度曲线 —— 起笔顿 / 行笔提按 / 收笔出锋（收锋处宽度收到 0，才是尖）
 *   ③ 侧锋     —— 中锋两侧宽度不等，笔才有「势」
 *   ④ 墨色     —— 起笔墨浓、收笔墨淡（蘸一次墨写到底）
 * ========================================================================== */
(function (root) {
  'use strict';

  var VIEW = 1000;

  function f(v) { return Math.round(v * 10) / 10; }

  /* ───────────────────────────── 宽度曲线预设 ───────────────────────────── */
  /* t ∈ [0,1]，返回半宽系数（1 = 设定宽度的满值） */
  var PROFILE = {
    /* 起笔顿 → 行笔匀 → 收笔出锋成尖。最像「一撇」 */
    pie: function (t) {
      if (t < 0.08) return 0.42 + 7.25 * t;            // 起笔一顿，迅速铺开
      if (t < 0.58) return 1 - 0.09 * (t - 0.08) / 0.5;
      return Math.max(0.02, 0.91 * (1 - Math.pow((t - 0.58) / 0.42, 1.25)));  // 出锋
    },
    /* 两头尖、中段饱 —— 叶子、花瓣、缨穗 */
    ye: function (t) { return Math.pow(Math.sin(Math.PI * t), 0.55); },
    /* 起笔重、一路收到尖 —— 根须、草叶、细枝 */
    xu: function (t) { return Math.max(0.03, Math.pow(1 - t, 0.85) * (1 - Math.exp(-14 * t))); },
    /* 两头略收、中段匀 —— 枪杆、竹竿这类「杆」 */
    gan: function (t) { return 0.72 + 0.28 * Math.pow(Math.sin(Math.PI * t), 0.4); },
    /* 点：起笔轻、按下去、提起来 */
    dian: function (t) { return Math.pow(Math.sin(Math.PI * Math.pow(t, 0.78)), 0.7); },
    /* 细丝：整体很细，末端几乎消失 */
    si: function (t) { return Math.max(0.02, 0.55 * Math.pow(1 - t, 0.6) * (1 - Math.exp(-18 * t))); },

    /* ★ 枝 / 根：起笔一顿 → 迅速铺开 → 缓收 → 末梢出锋成尖。
     *   为什么不用 xu：xu = pow(1-t, 0.85) 是指数衰减，长一点就瘦成一根线。
     *   实测木的根须（长 203）在 t=0.8 处只剩 13 单位宽 —— 76px 的牌面上是 1 个像素，
     *   渲染出来就是「细worm」。指数改 0.42 后同一位置有 26 单位，才立得住。 */
    zhi: function (t) {
      return Math.max(0.05, Math.pow(1 - t, 0.42) * Math.min(1, 0.55 + t * 5));
    },
    /* ★ 侧锋叶：贴笔处饱满、一路出锋。必须配 asym 用（一侧平、一侧鼓），
     *   否则对称纺锤 = 橄榄 = 眉毛。叶子的「势」全在侧锋上。 */
    ce: function (t) {
      return Math.max(0.04, Math.pow(1 - t, 0.62) * Math.min(1, 0.30 + t * 5));
    }
  };

  /* ───────────────────────────── 中心线平滑 ───────────────────────────── */
  /* Catmull-Rom 重采样：把 3~5 个控制点变成 40+ 个点，边缘才顺 */
  function resample(pts, seg) {
    seg = seg || 12;
    if (pts.length < 2) return pts.slice();
    var P = [pts[0]].concat(pts, [pts[pts.length - 1]]);
    var out = [];
    for (var i = 1; i < P.length - 2; i++) {
      var p0 = P[i - 1], p1 = P[i], p2 = P[i + 1], p3 = P[i + 2];
      for (var j = 0; j < seg; j++) {
        var t = j / seg, t2 = t * t, t3 = t2 * t;
        out.push({
          x: 0.5 * ((2 * p1.x) + (-p0.x + p2.x) * t +
                    (2 * p0.x - 5 * p1.x + 4 * p2.x - p3.x) * t2 +
                    (-p0.x + 3 * p1.x - 3 * p2.x + p3.x) * t3),
          y: 0.5 * ((2 * p1.y) + (-p0.y + p2.y) * t +
                    (2 * p0.y - 5 * p1.y + 4 * p2.y - p3.y) * t2 +
                    (-p0.y + 3 * p1.y - 3 * p2.y + p3.y) * t3)
        });
      }
    }
    out.push(P[P.length - 2]);
    return out;
  }

  /* 用「中点 + 二次贝塞尔」把点串平滑连起来 */
  function smooth(pts) {
    var n = pts.length;
    if (n === 0) return '';
    if (n === 1) return 'M' + f(pts[0].x) + ' ' + f(pts[0].y);
    var d = 'M' + f(pts[0].x) + ' ' + f(pts[0].y);
    for (var i = 1; i < n - 1; i++) {
      var mx = (pts[i].x + pts[i + 1].x) / 2, my = (pts[i].y + pts[i + 1].y) / 2;
      d += 'Q' + f(pts[i].x) + ' ' + f(pts[i].y) + ' ' + f(mx) + ' ' + f(my);
    }
    d += 'L' + f(pts[n - 1].x) + ' ' + f(pts[n - 1].y);
    return d;
  }

  /* ───────────────────────────── 生成笔触轮廓 ───────────────────────────── */
  /**
   * @param pts    中心线控制点数组 [{x,y},...]
   * @param opt    { w:半宽, profile:预设名或函数, asym:侧锋倾斜, seg, taperStart }
   * @returns      {'d': 路径, 'a': 起点, 'b': 终点}
   */
  function stroke(pts, opt) {
    opt = opt || {};
    var w = opt.w || 8;
    var prof = typeof opt.profile === 'function' ? opt.profile : (PROFILE[opt.profile] || PROFILE.pie);
    var asym = opt.asym == null ? 0 : opt.asym;   // -1..1，正值表示笔肚偏左
    var seg = opt.seg || 14;

    var c = resample(pts, seg);
    var n = c.length;
    if (n < 2) return { d: '', a: c[0], b: c[0] };

    var L = [], R = [];
    for (var i = 0; i < n; i++) {
      var t = i / (n - 1);
      /* 切线：用前后点差分，端点用单侧 */
      var p0 = c[Math.max(0, i - 1)], p1 = c[Math.min(n - 1, i + 1)];
      var tx = p1.x - p0.x, ty = p1.y - p0.y;
      var len = Math.hypot(tx, ty) || 1;
      var nx = -ty / len, ny = tx / len;           // 法线

      var hw = w * prof(t);
      var wl = hw * (1 + asym), wr = hw * (1 - asym);
      L.push({ x: c[i].x + nx * wl, y: c[i].y + ny * wl });
      R.push({ x: c[i].x - nx * wr, y: c[i].y - ny * wr });
    }

    var d = smooth(L);
    var rb = R.slice().reverse();
    d += smooth(rb).replace(/^M/, 'L');
    d += 'Z';

    return { d: d, a: c[0], b: c[n - 1] };
  }

  /* ───────────────────────────── 墨色 ───────────────────────────── */
  /* ★ 铁律：淡墨是「墨加水」，不是「灰色」。
   *
   * 上一版把淡墨写成 #666b74 —— 这是个蓝调冷灰（b=116 > r=102）。压在米黄宣纸上
   * 渲染出来是水泥/橡皮泥的颜色，一眼假。这就是「灰虫子」的色源。
   *
   * 正确算法：淡墨 = 纸色 × (1-α) + 墨色 × α。取纸 #f4f0e4、墨 #14161a：
   *   α=0.72 → #535352（重墨）   α=0.55 → #797875（淡墨）   α=0.38 → #9f9d97（清墨）
   * 三者的 r/g/b 基本相等且 b 略低 —— 暖中性，不带一丝蓝。 */
  var TONE = {
    jiao:  '#0e1012',   // 焦墨（最浓，只用于画眼级别的重笔）
    nong:  '#1c1e20',   // 浓墨
    zhong: '#535352',   // 重墨
    dan:   '#797875',   // 淡墨（暖中性）
    qing:  '#9f9d97',   // 清墨（最淡）
    zhu:   '#9e2b22',   // 朱砂（画眼，全图只点一两处）
    teng:  '#b8862b'    // 藤黄
  };

  var _gid = 0;

  /**
   * 把笔触包成可直接放进 SVG 的元素。
   * fade='tail' 时用沿笔轴的线性渐变，做「墨将尽」的渐隐。
   */
  function strokeEl(pts, opt) {
    opt = opt || {};
    var s = stroke(pts, opt);
    var tone = TONE[opt.tone || 'dan'] || opt.color || TONE.dan;
    var fill = tone, defs = '';
    if (opt.fade && opt.fade !== 'none') {
      var id = 'bg' + (++_gid);
      var a = s.a, b = s.b;
      var head = opt.fade === 'tail' ? tone : 'transparent';
      var tail = opt.fade === 'tail' ? 'transparent' : tone;
      defs = '<linearGradient id="' + id + '" gradientUnits="userSpaceOnUse" ' +
             'x1="' + f(a.x) + '" y1="' + f(a.y) + '" x2="' + f(b.x) + '" y2="' + f(b.y) + '">' +
             '<stop offset="0" stop-color="' + head + '"/>' +
             '<stop offset="' + (opt.fadeHold == null ? 0.45 : opt.fadeHold) + '" stop-color="' + tone + '"/>' +
             '<stop offset="1" stop-color="' + tail + '"/></linearGradient>';
      fill = 'url(#' + id + ')';
    }
    var op = opt.opacity == null ? 1 : opt.opacity;
    var blur = opt.blur ? ' filter="url(#' + opt.blur + ')"' : '';
    var el = '<path d="' + s.d + '" fill="' + fill + '" opacity="' + op + '"' + blur + '/>';
    return defs ? '<defs>' + defs + '</defs>' + el : el;
  }

  root.InkBrush = {
    VIEW: VIEW,
    TONE: TONE,
    PROFILE: PROFILE,
    stroke: stroke,
    strokeEl: strokeEl,
    resample: resample
  };
})(typeof window !== 'undefined' ? window : this);

/* ── ink-tile.js ── */
/* ============================================================================
 * 挪字成章 · 水墨牌面（第三版核心）
 * ----------------------------------------------------------------------------
 * 【为什么单独做牌面】
 * 前两版都把力气花在「字的旁边长物象」上，两版都丑。第三版想明白了：
 * 问题不在物象画得好不好，而在**位置错了**。
 *
 *   一张牌只有 76px。字本身吃掉 80% 的面积，剩下的边角最多容纳几笔细线 ——
 *   而「一小条灰」在人眼里永远被读成「附肢 / 污渍」，不可能被读成「枝叶、火焰、花」。
 *   ★ 所以：物象不该是「字的配件」，应该是「牌的底子」。
 *     一张淡墨的画纸上写一个字，是水墨画；一个字旁边挂几笔，是贴纸。
 *
 * 顺带这也补上了需求的第一条：「把整体风格优化，设计成水墨画风格」——
 * 牌面本身就是一幅小水墨。
 *
 * 【留白悖论，顺手解掉】
 * 字形归一化时只留了 6.3% 的边。牌面上一张画布全被墨占满，就没有留白，
 * 也就没有水墨的「呼吸」。这里把字重新按自己的墨迹包围盒适配到 76% 的画心，
 * 留出四周的空白：76px 的牌上字仍有 58px 高，可辨认度毫发无损。
 *
 * 【层序】陈纸 → 帘纹 → 墨韵（景，柔） → 字（主，锐） → 印（气眼）
 *   景柔字锐 = 景深。上一版把物象画得又锐又小，那才是唯一的错。
 * ========================================================================== */
(function (root) {
  'use strict';

  var B = root.InkBrush;
  var V = 1000;

  /* 稳定散列：同一张牌每次渲染必须长得一样，所以不能用 Math.random */
  function hash(s) {
    var h = 2166136261;
    for (var i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); }
    return h >>> 0;
  }

  /* ── 墨韵：纸上一笔扫过的淡墨。位置按字散列，让整盘牌有变化，不做成复制粘贴 ──
   * 每一张牌给「两笔」：一大一小、一主一次、分处两个角。
   * 只给一笔时画面是平的；给两笔才有前后远近，才是「画」。
   * 形状取「长扫」——圆心在牌外、扫过一角，这样墨是从边上洇进来的，
   * 而不是在纸中间凭空出现一个圆斑（那样读出来是霉点）。
   * 中心必须干净 —— 字要落在没被洇湿的地方，墨才不糊。 */
  var WASH = [
    { a: { cx: 96, cy: 118, rx: 620, ry: 214, ang: -26 }, b: { cx: 928, cy: 906, rx: 330, ry: 130, ang: -38 } },
    { a: { cx: 84, cy: 130, rx: 590, ry: 200, ang: 30 }, b: { cx: 906, cy: 884, rx: 356, ry: 142, ang: -22 } },
    { a: { cx: 906, cy: 112, rx: 604, ry: 208, ang: 28 }, b: { cx: 96, cy: 892, rx: 340, ry: 136, ang: 22 } },
    { a: { cx: 500, cy: 42, rx: 660, ry: 150, ang: -3 }, b: { cx: 512, cy: 962, rx: 600, ry: 152, ang: 2 } },
    { a: { cx: 108, cy: 918, rx: 610, ry: 212, ang: 24 }, b: { cx: 900, cy: 120, rx: 348, ry: 138, ang: 36 } },
    { a: { cx: 924, cy: 892, rx: 630, ry: 218, ang: -28 }, b: { cx: 104, cy: 132, rx: 334, ry: 130, ang: -20 } }
  ];

  /* ── 印章：右下角。76px 的牌上它只是一个小红点 —— 那正是「惜色如金」的效果 ── */
  function seal(ch, x, y, s, op) {
    var inner = root.InkGlyphs && root.InkGlyphs.has('章') ? root.InkGlyphs.path('章') : '';
    var box = (root.InkGlyphs && root.InkGlyphs.box('章')) || [0, 0, 1000, 1000];
    var w = box[2] - box[0], h = box[3] - box[1];
    var k = (s - s * 0.26) / Math.max(w, h);
    /* 印章里是「白文」：朱砂底、纸色的字 —— 所以字用纸色画在朱砂方上 */
    return '<g opacity="' + op + '">' +
      '<rect x="' + x + '" y="' + y + '" width="' + s + '" height="' + s + '" rx="' + (s * 0.07) +
        '" fill="#9c2b21" fill-opacity=".88" filter="url(#feiBai)"/>' +
      (inner ? '<g transform="translate(' + (x + s / 2) + ',' + (y + s / 2) + ') scale(' + k.toFixed(4) + ') ' +
        'translate(' + (-(box[0] + w / 2)).toFixed(1) + ',' + (-(box[1] + h / 2)).toFixed(1) + ')">' +
        '<path d="' + inner + '" fill="#f3eee1"/></g>' : '') +
      '</g>';
  }

  /**
   * @param ch   字
   * @param opt  { style:'bai'|'ge'  牌面式样
   *               wash:true|false    是否要墨韵
   *               seal:true|false    是否要印章
   *               fit:0.76           字占画心的比例
   *               seed:0             额外扰动（同一字要不同效果时用） }
   * @returns    可直接塞进 <svg viewBox="0 0 1000 1000"> 的内容
   */
  function svg(ch, opt) {
    opt = opt || {};
    var style = opt.style || 'bai';
    var useWash = opt.wash !== false;
    var useSeal = opt.seal !== false;
    var fit = opt.fit == null ? 0.76 : opt.fit;
    var seed = opt.seed || 0;

    var h = hash(ch) + seed * 7919;
    var s = [];
    s.push('<rect width="1000" height="1000" fill="#f3eee1"/>');
    /* 纸：先不平的明暗，再帘纹 */
    s.push('<rect width="1000" height="1000" filter="url(#chenZhi)"/>');
    s.push('<rect width="1000" height="1000" filter="url(#xianWei)"/>');

    /* 墨韵：景 —— 两笔，极淡，柔 */
    if (useWash) {
      var w = WASH[h % WASH.length];
      var opA = 0.15 + ((h >> 5) % 6) * 0.018;          // 主团 0.150 ~ 0.240
      var opB = opA * (0.62 + ((h >> 11) % 4) * 0.09);  // 次团一直是主团的六到九成
      s.push('<g filter="url(#moYun)">' +
        '<ellipse cx="' + w.a.cx + '" cy="' + w.a.cy + '" rx="' + w.a.rx + '" ry="' + w.a.ry +
        '" transform="rotate(' + w.a.ang + ' ' + w.a.cx + ' ' + w.a.cy + ')" fill="url(#yunGrad)" opacity="' + opA.toFixed(3) + '"/>' +
        '<ellipse cx="' + w.b.cx + '" cy="' + w.b.cy + '" rx="' + w.b.rx + '" ry="' + w.b.ry +
        '" transform="rotate(' + w.b.ang + ' ' + w.b.cx + ' ' + w.b.cy + ')" fill="url(#yunGrad)" opacity="' + opB.toFixed(3) + '"/>' +
        '</g>');
    }

    /* 格线：书法练习纸的淡墨边框 —— 既给玩法明确的边界，本身也是国画语言。
       76px 时它会细到几乎看不见，所以只在大牌上起作用，小牌上退成一点灰边。 */
    if (style === 'ge') {
      s.push('<g opacity=".5">' +
        '<rect x="66" y="66" width="868" height="868" fill="none" stroke="#8e8b80" stroke-width="3"/>' +
        '<rect x="82" y="82" width="836" height="836" fill="none" stroke="#8e8b80" stroke-width="1.4" opacity=".7"/>' +
        '</g>');
    }

    /* 字：主 —— 按自己的墨迹包围盒适配到画心，保证每张牌的「视觉字号」一致 */
    var box = (root.InkGlyphs && root.InkGlyphs.box(ch)) || [63, 63, 937, 937];
    var bw = Math.max(1, box[2] - box[0]), bh = Math.max(1, box[3] - box[1]);
    var target = V * fit;
    var k = target / Math.max(bw, bh);
    var dx = V / 2 - (box[0] + bw / 2) * k;
    var dy = V / 2 - (box[1] + bh / 2) * k;
    var d = (root.InkGlyphs && root.InkGlyphs.path(ch)) || '';
    /* ★ 极少数生僻字（匊 夆 戉 枼 罒）马善政里没有，是用系统宋体补的
       （origin === 'songti'）。宋体笔画明显比毛笔楷书细，并排一眼能看出不是同一支笔。
       给它们描一道同色边，把视觉重量补回来 —— 代价是字略「胖」一点，
       但比「一眼看出不是一种字体」好得多。 */
    var thin = root.InkGlyphs && root.InkGlyphs.origin && root.InkGlyphs.origin[ch] === 'songti';
    s.push('<g transform="translate(' + dx.toFixed(1) + ',' + dy.toFixed(1) + ') scale(' + k.toFixed(4) + ')">' +
      '<path d="' + d + '" fill="url(#moGrad)" filter="url(#inkMo)"' +
      (thin ? ' stroke="url(#moGrad)" stroke-width="30" stroke-linejoin="round" stroke-linecap="round"' : '') +
      '/></g>');

    /* 印：右下角的气眼 */
    if (useSeal) s.push(seal(ch, 848, 848, 100, 0.92));

    return s.join('');
  }

  root.InkTile = {
    svg: svg,
    WASH: WASH,
    hash: hash,
    styleList: ['bai', 'ge']
  };
})(typeof window !== 'undefined' ? window : this);

/* ==INLINE-JS-END== */

/* ==LEVELS-V2-BEGIN== */
/* ============================================================
   1. 字库（拆字表）  —— 103 字，由 assets/wordlib.json 生成
   ============================================================ */
/* 103 字：a = 本作说的「偏旁」（左/上半边），b = 另一半。
   ★ 配对是无序的，a/b 谁先谁后都能拼（见下方 PAIR 双向建索引）。
   来源：assets/wordlib.json —— 由 tools/apply-levels-v2.py 生成，勿手工改。 */
const WORDS = {
  '枪':{a:'木',b:'仓'}, '棍':{a:'木',b:'昆'}, '棒':{a:'木',b:'奉'}, '杖':{a:'木',b:'丈'},
  '柄':{a:'木',b:'丙'}, '槌':{a:'木',b:'追'}, '杵':{a:'木',b:'午'}, '锤':{a:'钅',b:'垂'},
  '钩':{a:'钅',b:'勾'}, '镰':{a:'钅',b:'廉'}, '锏':{a:'钅',b:'间'}, '箭':{a:'竹',b:'前'},
  '鞭':{a:'革',b:'便'}, '鞘':{a:'革',b:'肖'}, '靶':{a:'革',b:'巴'}, '斧':{a:'父',b:'斤'},
  '弩':{a:'奴',b:'弓'}, '剑':{a:'佥',b:'刂'}, '铠':{a:'钅',b:'岂'}, '花':{a:'艹',b:'化'},
  '莲':{a:'艹',b:'连'}, '莉':{a:'艹',b:'利'}, '茉':{a:'艹',b:'末'}, '蓉':{a:'艹',b:'容'},
  '苇':{a:'艹',b:'韦'}, '萍':{a:'艹',b:'平'}, '萝':{a:'艹',b:'罗'}, '蕾':{a:'艹',b:'雷'},
  '荷':{a:'艹',b:'何'}, '桃':{a:'木',b:'兆'}, '柳':{a:'木',b:'卯'}, '梅':{a:'木',b:'每'},
  '桂':{a:'木',b:'圭'}, '枫':{a:'木',b:'风'}, '桦':{a:'木',b:'华'}, '樱':{a:'木',b:'婴'},
